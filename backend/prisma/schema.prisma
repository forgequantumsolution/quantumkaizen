generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  name         String

  employeeId  String? @unique
  firstName   String?
  lastName    String?
  phone       String?
  designation String?

  isActive Boolean @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  joinDate    DateTime?
  lastLoginAt DateTime?
  avatarUrl   String?
  locale      String    @default("en")
  timezone    String    @default("Asia/Kolkata")

  signatureMeaning    String?
  signaturePinHash    String?
  signatureEnrolledAt DateTime?

  headOfDepartments Department[] @relation("DepartmentHead")

  workflowsCreated Workflow[]            @relation("WorkflowCreatedBy")
  workflowsDeleted Workflow[]            @relation("WorkflowDeletedBy")
  stageActions     WorkflowStageAction[] @relation("StageActionAllowedUsers")

  ticketsCreated         Ticket[]              @relation("TicketCreatedBy")
  ticketsDeleted         Ticket[]              @relation("TicketDeletedBy")
  ticketsHeld            Ticket[]              @relation("TicketHeldBy")
  commentsAuthored       TicketComment[]       @relation("TicketCommentAuthor")
  docsUploaded           TicketDoc[]           @relation("TicketDocUploadedBy")
  stageTrackingPerformed TicketStageTracking[] @relation("TicketStageTrackingPerformedBy")

  formsCreated     Form[]           @relation("FormCreatedBy")
  formDraftsSaved  FormDraft[]      @relation("FormDraftSavedBy")
  formSubmissions  FormSubmission[] @relation("FormSubmissionSubmittedBy")
  auditSchedules   AuditSchedule[]  @relation("AuditScheduleCreatedBy")

  // Phase 3 — Approvals + SLA
  approverOnPolicies      ApprovalPolicy[] @relation("ApprovalPolicyApproverUsers")
  approvalRecords         ApprovalRecord[] @relation("UserApprovalRecords")
  slaPolicyResponsibleFor SlaPolicy[]      @relation("SlaPolicyResponsibleUsers")
  slaThresholdNotifyFor   SlaThreshold[]   @relation("SlaThresholdNotifyUsers")
  slaExtensionsRequested  SlaExtension[]   @relation("SlaExtensionRequestedBy")
  slaExtensionsApproved   SlaExtension[]   @relation("SlaExtensionApprover")
  slaTimerEventsTriggered SlaTimerEvent[]  @relation("SlaTimerEventTriggeredBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([roleId])
  @@index([siteId])
  @@index([managerId])
}

model Department {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String  @unique
  description String?

  parentId String?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  headUserId String?
  head       User?   @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)

  costCenter String?
  isActive   Boolean @default(true)

  users   User[]
  tickets Ticket[] @relation("TicketDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([headUserId])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  permissions Permission[] @relation("RolePermissions")
  users       User[]

  stageActions WorkflowStageAction[] @relation("StageActionAllowedRoles")

  // Phase 3 — Approvals + SLA
  approverOnPolicies      ApprovalPolicy[] @relation("ApprovalPolicyApproverRoles")
  approvalRecordsAsRole   ApprovalRecord[] @relation("ApprovalRecordRole")
  slaPolicyResponsibleFor SlaPolicy[]      @relation("SlaPolicyResponsibleRoles")
  slaThresholdNotifyFor   SlaThreshold[]   @relation("SlaThresholdNotifyRoles")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  module      String
  action      String
  description String

  roles Role[] @relation("RolePermissions")

  createdAt DateTime @default(now())

  @@index([module])
}

model Site {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  address  String?
  isActive Boolean @default(true)

  users   User[]
  tickets Ticket[] @relation("TicketSite")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  tenantCode String   @unique
  industry   String
  website    String?
  address    String?
  standards  String[]
  timezone   String   @default("Asia/Kolkata")
  dateFormat String   @default("DD/MM/YYYY")
  logoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow domain (Phase 1 — builder layer only; engine/SLA/forms in later phases)
// ─────────────────────────────────────────────────────────────────────────────

enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkflowLifecycleStatus {
  ACTIVE
  INACTIVE
  DRAFT
  DRAFT_UPDATE
}

enum StageType {
  STAGE
  FORK
  JOIN
  DECISION
  AUDIT_FORMS
}

enum SplitType {
  AND
  OR
  XOR
}

enum JoinType {
  AND
  OR
}

enum StageActionBehavior {
  FORWARD
  REJECT
  HOLD
  UNHOLD
  RETURN
  REASSIGN
}

model WorkflowType {
  id         String  @id @default(uuid())
  name       String  @unique
  codePrefix String?
  isDeleted  Boolean @default(false)

  workflows  Workflow[]
  iconConfig WorkflowIconConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowIconConfig {
  id             String       @id @default(uuid())
  workflowTypeId String       @unique
  workflowType   WorkflowType @relation(fields: [workflowTypeId], references: [id], onDelete: Cascade)
  iconName       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowStageStatus {
  id        String              @id @default(uuid())
  name      String              @unique
  behavior  StageActionBehavior @default(FORWARD)
  isDeleted Boolean             @default(false)

  stageActions WorkflowStageAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionType {
  id        String  @id @default(uuid())
  name      String  @unique
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionCriteria {
  id        String  @id @default(uuid())
  name      String
  isDeleted Boolean @default(false)

  stageActions WorkflowStageAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Priority {
  id   String @id @default(uuid())
  name String @unique

  tickets Ticket[]
}

model Workflow {
  id   String @id @default(uuid())
  name String

  typeId String?
  type   WorkflowType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  status         WorkflowApprovalStatus  @default(PENDING)
  workflowStatus WorkflowLifecycleStatus @default(DRAFT)

  totalExecutions      Int       @default(0)
  successfulExecutions Int       @default(0)
  failedExecutions     Int       @default(0)
  lastExecutedAt       DateTime?
  maxExecutionsPerDay  Int?
  timeoutSeconds       Int?

  version         Int     @default(1)
  isLatestVersion Boolean @default(true)

  previousVersionId String?
  previousVersion   Workflow?  @relation("WorkflowVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions      Workflow[] @relation("WorkflowVersionChain")

  parentWorkflowId String?
  parentWorkflow   Workflow?  @relation("WorkflowLineage", fields: [parentWorkflowId], references: [id], onDelete: SetNull)
  childWorkflows   Workflow[] @relation("WorkflowLineage")

  draftOfId String?
  draftOf   Workflow?  @relation("WorkflowDraftOf", fields: [draftOfId], references: [id], onDelete: Cascade)
  drafts    Workflow[] @relation("WorkflowDraftOf")

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("WorkflowDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  stages      WorkflowStage[]
  transitions WorkflowTransition[]
  temporary   TemporaryWorkflow?

  flows         TicketFlow[]
  childTriggers ChildWorkflowTrigger[] @relation("WorkflowChildTriggers")

  // Phase 3 — Approvals + SLA escalation
  approvalPolicies ApprovalPolicy[] @relation("WorkflowApprovalPolicies")
  usedAsSlaEscalation SlaPolicy[]   @relation("WorkflowAsSlaEscalation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isLatestVersion, isDeleted])
  @@index([typeId])
  @@index([parentWorkflowId])
  @@index([draftOfId])
}

model WorkflowStage {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name           String
  canonicalId    String  @default("")
  isInitialStage Boolean @default(false)
  sendEmail      Boolean @default(false)
  additionalData Json?

  stageType StageType  @default(STAGE)
  splitType SplitType?
  joinType  JoinType?

  joinPointId String?
  joinPoint   WorkflowStage?  @relation("StageForkJoin", fields: [joinPointId], references: [id], onDelete: SetNull)
  forkPoints  WorkflowStage[] @relation("StageForkJoin")

  actions             WorkflowStageAction[]
  outgoingTransitions WorkflowTransition[]  @relation("FromStage")
  incomingTransitions WorkflowTransition[]  @relation("ToStage")

  currentForFlows      TicketFlow[]             @relation("TicketFlowCurrentStages")
  stageTracking        TicketStageTracking[]
  parentTickets        Ticket[]                 @relation("TicketParentStage")
  forkBranches         ParallelBranchTracking[] @relation("ForkBranchTracking")
  joinBranches         ParallelBranchTracking[] @relation("JoinBranchTracking")
  childTriggers        ChildWorkflowTrigger[]   @relation("StageChildTriggers")
  docs                 TicketDoc[]              @relation("TicketDocStage")
  returnedFromTracking TicketStageTracking[]    @relation("StageTrackingReturnedFrom")

  // Phase 3 — Approvals + SLA
  approvalPolicies    ApprovalPolicy[] @relation("StageApprovalPolicies")
  slaPolicy           SlaPolicy?       @relation("StageSlaPolicy")
  slaTimers           SlaTimer[]       @relation("StageSlaTimers")
  slaThresholdTargets SlaThreshold[]   @relation("SlaThresholdTargetStage")

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId, isInitialStage])
  @@index([canonicalId])
}

model WorkflowStageAction {
  id              String        @id @default(uuid())
  workflowStageId String
  workflowStage   WorkflowStage @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)

  workflowActionId String
  workflowAction   WorkflowStageStatus @relation(fields: [workflowActionId], references: [id], onDelete: Cascade)

  criteriaId String?
  criteria   ActionCriteria? @relation(fields: [criteriaId], references: [id], onDelete: SetNull)

  isPrimary Boolean @default(true)

  allowedRoles Role[] @relation("StageActionAllowedRoles")
  allowedUsers User[] @relation("StageActionAllowedUsers")

  postActionsTracking TicketStageTracking[] @relation("StageTrackingPostAction")

  // Phase 3 — Approvals
  approvalPolicies           ApprovalPolicy[]   @relation("ActionApprovalPolicies")
  triggeredApprovalInstances ApprovalInstance[] @relation("ActionTriggeringInstances")

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowStageId, workflowActionId])
}

model WorkflowTransition {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromStageId String
  fromStage   WorkflowStage @relation("FromStage", fields: [fromStageId], references: [id], onDelete: Cascade)

  toStageId String
  toStage   WorkflowStage @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)

  sourcePort  String?
  targetPort  String?
  branchName  String?
  condition   String?
  branchOrder Int     @default(0)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromStageId])
  @@index([toStageId])
  @@index([workflowId])
}

model TemporaryWorkflow {
  id         String   @id @default(uuid())
  workflowId String   @unique
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  flowJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Ticket domain (Phase 2 — execution; engine layers in src/modules/workflow/engine)
// ─────────────────────────────────────────────────────────────────────────────

enum DocType {
  ATTACHMENT
  EVIDENCE
  REPORT
  FORM_SUBMISSION
  OTHER
}

enum ChildTriggerMode {
  MANUAL
  AUTO
}

enum ParallelBranchStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Ticket {
  id           String  @id @default(uuid())
  uniqueId     String  @unique
  title        String
  description  String?
  ticketReason String?

  parentTicketId String?
  parentTicket   Ticket?  @relation("TicketParent", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets   Ticket[] @relation("TicketParent")

  parentTicketStageId String?
  parentTicketStage   WorkflowStage? @relation("TicketParentStage", fields: [parentTicketStageId], references: [id], onDelete: SetNull)

  priorityId String?
  priority   Priority? @relation(fields: [priorityId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation("TicketDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation("TicketSite", fields: [siteId], references: [id], onDelete: SetNull)

  customFields Json?

  isOnHold   Boolean   @default(false)
  holdReason String?
  heldAt     DateTime?
  heldById   String?
  heldBy     User?     @relation("TicketHeldBy", fields: [heldById], references: [id], onDelete: SetNull)

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("TicketDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  flows            TicketFlow[]
  comments         TicketComment[]
  docs             TicketDoc[]
  stageTracking    TicketStageTracking[]
  parallelTracking ParallelBranchTracking[]

  // Phase 3 — Approvals + SLA
  approvalInstances     ApprovalInstance[] @relation("TicketApprovalInstances")
  slaTimers             SlaTimer[]         @relation("TicketSlaTimers")
  // Back-relation for SlaTimer.escalationTicket — set when this ticket IS the
  // spawned escalation child (so we can query "is this an SLA-escalation ticket?").
  slaTimersAsEscalation SlaTimer[]         @relation("TicketAsSlaEscalation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uniqueId])
  @@index([createdById, createdAt])
  @@index([priorityId, createdAt])
  @@index([isDeleted, createdAt])
  @@index([parentTicketId, isDeleted])
}

model TicketFlow {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  workflowName    String
  workflowVersion Int

  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  statusUpdatedAt DateTime  @default(now())

  currentStages WorkflowStage[] @relation("TicketFlowCurrentStages")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketId, workflowId])
  @@index([workflowId, isCompleted])
  @@index([ticketId, isCompleted])
}

model TicketStageTracking {
  id       String         @id @default(uuid())
  ticketId String
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  stageId  String?
  stage    WorkflowStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  stageName       String
  stageWorkflowId String

  enteredAt   DateTime  @default(now())
  exitedAt    DateTime?
  durationSec Int?

  isActive   Boolean @default(true)
  isOnHold   Boolean @default(false)
  holdReason String?

  performedById String?
  performedBy   User?   @relation("TicketStageTrackingPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  postActionId String?
  postAction   WorkflowStageAction? @relation("StageTrackingPostAction", fields: [postActionId], references: [id], onDelete: SetNull)

  returnedFromStageId String?
  returnedFromStage   WorkflowStage? @relation("StageTrackingReturnedFrom", fields: [returnedFromStageId], references: [id], onDelete: SetNull)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, stageId, isActive])
  @@index([ticketId, isActive])
  @@index([stageWorkflowId, isActive])
  @@index([enteredAt])
}

model TicketComment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body     String
  authorId String?
  author   User?   @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

model TicketDoc {
  id       String         @id @default(uuid())
  ticketId String
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  stageId  String?
  stage    WorkflowStage? @relation("TicketDocStage", fields: [stageId], references: [id], onDelete: SetNull)

  fileUrl       String
  fileName      String
  mimeType      String?
  fileSizeBytes Int?
  docType       DocType @default(ATTACHMENT)

  uploadedById String?
  uploadedBy   User?   @relation("TicketDocUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

model ChildWorkflowTrigger {
  id              String           @id @default(uuid())
  parentStageId   String
  parentStage     WorkflowStage    @relation("StageChildTriggers", fields: [parentStageId], references: [id], onDelete: Cascade)
  childWorkflowId String
  childWorkflow   Workflow         @relation("WorkflowChildTriggers", fields: [childWorkflowId], references: [id], onDelete: Restrict)
  triggerMode     ChildTriggerMode @default(MANUAL)
  isBlocking      Boolean          @default(false)
  allowMultiple   Boolean          @default(false)
  order           Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParallelBranchTracking {
  id          String         @id @default(uuid())
  ticketId    String
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  forkStageId String
  forkStage   WorkflowStage  @relation("ForkBranchTracking", fields: [forkStageId], references: [id], onDelete: Cascade)
  joinStageId String?
  joinStage   WorkflowStage? @relation("JoinBranchTracking", fields: [joinStageId], references: [id], onDelete: SetNull)

  branchPath  Json
  status      ParallelBranchStatus @default(ACTIVE)
  startedAt   DateTime             @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, forkStageId, status])
}

// =====================================================================
// Dynamic Form Builder
// =====================================================================

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormSubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

// User-extensible field type registry. Built-ins (text, number, select,
// table, signature, ...) are seeded; users can add their own via
// FieldTypeManager.
model FieldType {
  id          String  @id @default(uuid())
  name        String  @unique // machine name e.g. "text", "select"
  label       String  // display name
  description String?
  dataType    String? // primitive: string|number|boolean|date|json|file
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)
  config      Json?   // default validation/options blob

  fields FormField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Checklist categories: Audit, Inspection, Calibration, etc.
model FormType {
  id        String  @id @default(uuid())
  name      String  @unique
  versionId String  @unique // immutable identifier per version, exposed to FE
  isActive  Boolean @default(true)

  forms Form[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A versioned form template. Each version is a separate row sharing a
// templateKey so the FE can list `all_versions`.
model Form {
  id          String     @id @default(uuid())
  templateKey String     // groups versions of the same logical form
  title       String
  description String?
  version     Int        @default(1)
  versionId   String     @unique // immutable per version
  status      FormStatus @default(DRAFT)
  isCompleted Boolean    @default(false)

  formTypeId String?
  formType   FormType? @relation(fields: [formTypeId], references: [id], onDelete: SetNull)

  // Optional PDCA / audit context
  location    String?
  mainProcess String?
  criteria    String?
  pdcaApproved Boolean @default(false)

  workflowName String?
  workflowType String?

  createdById String?
  createdBy   User?   @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sections    FormSection[]
  draft       FormDraft?
  submissions FormSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateKey, version])
  @@index([formTypeId])
  @@index([status])
}

model FormSection {
  id          String  @id @default(uuid())
  sectionId   String  // FE-side identifier
  name        String
  position    Int     @default(0)
  dependency  Json?   // conditional visibility rules

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  fields FormField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, position])
}

model FormField {
  id        String @id @default(uuid())
  fieldId   String // FE-side identifier used in submission payloads
  name      String // unique within section, used as JSON key
  label     String
  position  Int    @default(0)
  width     String @default("100") // 25/33/50/66/75/100 grid
  required  Boolean @default(false)

  // Field type — by id (preferred) or by name string for legacy/built-in
  typeId String?
  type   FieldType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  typeName String?

  defaultValue Json?
  options      Json? // [{label, value}]
  validation   Json? // arbitrary validation blob (see FE validationRules)
  dependency   Json? // conditional visibility

  // Dynamic / API-driven options
  dynamic      Boolean @default(false)
  endpoint     String?

  // Auto-generate from API
  autoGenerate         Boolean @default(false)
  autoGenerateEndpoint String?
  autoGenerateMappings Json?

  sectionId String
  section   FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Nested fields for table-type (parent has type=table)
  parentFieldId String?
  parentField   FormField?  @relation("FormFieldChildren", fields: [parentFieldId], references: [id], onDelete: Cascade)
  children      FormField[] @relation("FormFieldChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, position])
  @@index([parentFieldId])
}

// Single freeform draft snapshot per form (overwritten on every save).
model FormDraft {
  id        String @id @default(uuid())
  formId    String @unique
  form      Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  draftData    Json
  formDetails  Json
  versionId    String?

  savedById String?
  savedBy   User?   @relation("FormDraftSavedBy", fields: [savedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A filled-in form response.
model FormSubmission {
  id        String @id @default(uuid())
  formId    String
  form      Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  versionId String

  status    FormSubmissionStatus @default(IN_PROGRESS)
  responses Json   // { sectionName: { fieldName: value } }
  meta      Json?  // arbitrary attachments / context

  submittedById String?
  submittedBy   User?   @relation("FormSubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, status])
  @@index([submittedById])
}

// =====================================================================
// ISO standards / audit checklists
// =====================================================================

model IsoStandard {
  id        String  @id @default(uuid())
  name      String  @unique
  remarks   String?
  isActive  Boolean @default(true)

  clauses IsoClause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IsoClause {
  id            String @id @default(uuid())
  clauseNumber  String
  clauseTitle   String
  position      Int    @default(0)

  standardId String
  standard   IsoStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  subClauses IsoSubClause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([standardId, position])
}

model IsoSubClause {
  id              String  @id @default(uuid())
  subClauseNumber String
  subClauseTitle  String
  requirementText String?
  position        Int     @default(0)

  clauseId String
  clause   IsoClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clauseId, position])
}

model AuditSchedule {
  id              String   @id @default(uuid())
  title           String
  plant           String?
  description     String?
  auditDate       DateTime
  previousAuditDate DateTime?
  financialYear   String?
  auditMethod     String?
  isActive        Boolean  @default(true)

  // Free-form arrays of {id, name} kept as JSON to avoid coupling to other modules
  locations   Json?
  mainProcesses Json?
  subProcesses Json?
  criteria    Json?
  departments Json?
  focusAreas  Json?

  createdById String?
  createdBy   User?   @relation("AuditScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialYear])
  @@index([auditDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Approvals + SLA
// Plan: docs/WORKFLOW_PHASE_3_PLAN.md
// Migration: 20260512161347_workflow_phase3_approvals_sla
// ─────────────────────────────────────────────────────────────────────────────

enum ApprovalMode {
  SINGLE
  ALL_REQUIRED
  QUORUM
  SEQUENTIAL
  ANY
}

// Match Django's instance lifecycle: a policy is "SATISFIED" when its mode's
// quorum/sequence rule is met (not just one approval). `INVALIDATED` lets
// admins void an in-flight instance when the policy itself is edited, with
// reason captured on the instance.
enum ApprovalInstanceStatus {
  PENDING
  SATISFIED
  REJECTED
  EXPIRED
  INVALIDATED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// `RUNNING` = clock active, no extensions granted; `EXTENDED` = clock active
// and at least one extension has been granted (distinct so the UI can badge it).
enum SlaTimerStatus {
  RUNNING
  PAUSED
  EXTENDED
  COMPLETED
  BREACHED
}

// `SLA_TRANSITION` = the escalation ticket was auto-advanced by the threshold
// sweep (the parent ticket is never moved by SLA cron — see SlaPolicy.escalationWorkflow).
// `COMPLETED_LATE` = parent stage exited *after* deadline passed (status went
// BREACHED first, then exited cleanly).
enum SlaEventType {
  STARTED
  PAUSED
  RESUMED
  THRESHOLD_HIT
  SLA_TRANSITION
  EXTENDED
  COMPLETED
  COMPLETED_LATE
  BREACHED
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Approvals (3 tables) ──────────────────────────────────────────────────

model ApprovalPolicy {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation("WorkflowApprovalPolicies", fields: [workflowId], references: [id], onDelete: Cascade)
  stageId    String
  stage      WorkflowStage @relation("StageApprovalPolicies", fields: [stageId], references: [id], onDelete: Cascade)
  actionId   String
  action     WorkflowStageAction @relation("ActionApprovalPolicies", fields: [actionId], references: [id], onDelete: Cascade)

  mode                   ApprovalMode
  requiredCount          Int     @default(1)
  // `strictRoleMatch=true` means "approver's role must be exactly in approverRoles"
  // (ignore role hierarchy). Default false = honor hierarchy (head-of-dept can
  // approve for an underling's role).
  strictRoleMatch        Boolean @default(false)
  allowSelfApproval      Boolean @default(false)
  requireUniqueApprovers Boolean @default(true)
  // For mode=SEQUENTIAL — ordered list of `{ order, role_id | user_id, label }`.
  approvalSequence       Json?
  approvalSlaHours       Int?

  // `isActive=false` retires a policy without deleting it (preserves history
  // via existing ApprovalInstance rows). `isDeleted` is the soft-delete tombstone.
  isActive Boolean @default(true)

  approverRoles Role[] @relation("ApprovalPolicyApproverRoles")
  approverUsers User[] @relation("ApprovalPolicyApproverUsers")

  instances ApprovalInstance[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stageId, actionId])
  @@index([workflowId])
}

model ApprovalInstance {
  id                 String         @id @default(uuid())
  ticketId           String
  ticket             Ticket         @relation("TicketApprovalInstances", fields: [ticketId], references: [id], onDelete: Cascade)
  policyId           String
  policy             ApprovalPolicy @relation(fields: [policyId], references: [id], onDelete: Restrict)
  triggeringActionId String?
  triggeringAction   WorkflowStageAction? @relation("ActionTriggeringInstances", fields: [triggeringActionId], references: [id], onDelete: SetNull)

  status      ApprovalInstanceStatus @default(PENDING)
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  deadlineAt  DateTime?
  // For SEQUENTIAL mode: which step in the approval_sequence we're waiting on.
  currentSequenceOrder Int @default(1)

  // When status=INVALIDATED — captures who/why so audit can explain why an
  // in-flight instance was voided (typically because the underlying policy
  // changed mid-approval and a fresh instance had to be opened).
  invalidatedAt     DateTime?
  invalidatedReason String?

  records ApprovalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, status])
  @@index([policyId, status])
  @@index([deadlineAt])
}

model ApprovalRecord {
  id         String           @id @default(uuid())
  instanceId String
  instance   ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  approverId String
  approver   User             @relation("UserApprovalRecords", fields: [approverId], references: [id], onDelete: Restrict)

  // Audit trail of which role the approver acted under — matters when a user
  // holds multiple roles and the policy allows any of them.
  approvedAsRoleId String?
  approvedAsRole   Role?   @relation("ApprovalRecordRole", fields: [approvedAsRoleId], references: [id], onDelete: SetNull)

  decision  ApprovalDecision
  comment   String?
  decidedAt DateTime         @default(now())

  // For SEQUENTIAL mode — which step in the sequence this record satisfied.
  sequenceOrder Int @default(0)

  // Phase-4 e-signature link (no FK target yet — the WorkflowStageSignature
  // model lands in Phase 4. Field reserved so Phase 4 can attach without
  // re-migrating this table).
  stageSignatureId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, approverId])
  @@index([instanceId])
}

// ─── SLA (6 tables) ────────────────────────────────────────────────────────

model BusinessCalendar {
  id             String  @id @default(uuid())
  name           String  @unique
  timezone       String  @default("Asia/Kolkata")
  weeklySchedule Json
  holidays       Json
  isActive       Boolean @default(true)
  isDeleted      Boolean @default(false)

  policies SlaPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlaPolicy {
  id            String         @id @default(uuid())
  parentStageId String         @unique
  parentStage   WorkflowStage  @relation("StageSlaPolicy", fields: [parentStageId], references: [id], onDelete: Cascade)

  duration                Int
  calendarId              String?
  calendar                BusinessCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  pauseOnHold             Boolean @default(true)
  pauseOnExtensionPending Boolean @default(false)

  // Escalation workflow that gets spawned as a CHILD ticket when the parent
  // ticket enters this stage. The threshold cron only ever advances that
  // child — the parent ticket is never auto-moved by SLA. If null, no
  // escalation ticket is spawned (thresholds fire events only, for notifications).
  escalationWorkflowId String?
  escalationWorkflow   Workflow? @relation("WorkflowAsSlaEscalation", fields: [escalationWorkflowId], references: [id], onDelete: SetNull)

  responsibleRoles Role[] @relation("SlaPolicyResponsibleRoles")
  responsibleUsers User[] @relation("SlaPolicyResponsibleUsers")

  thresholds SlaThreshold[]
  timers     SlaTimer[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calendarId])
  @@index([escalationWorkflowId])
}

model SlaThreshold {
  id       String    @id @default(uuid())
  policyId String
  policy   SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  // Human-readable name surfaced in UI/events (e.g. 'warning', 'critical', 'breach').
  // Required so events can be queried by name regardless of percentage tweaks.
  name       String
  // Float instead of Int — Django uses float so fractional thresholds like 33.3% work.
  percentage Float

  // Target stage in the ESCALATION workflow (not the parent workflow). When
  // the threshold fires, the spawned escalation ticket is moved to this stage.
  // If null, the threshold only fires an event (notification-only).
  targetSlaStageId String?
  targetSlaStage   WorkflowStage? @relation("SlaThresholdTargetStage", fields: [targetSlaStageId], references: [id], onDelete: SetNull)

  notifyRoles Role[] @relation("SlaThresholdNotifyRoles")
  notifyUsers User[] @relation("SlaThresholdNotifyUsers")

  events SlaTimerEvent[] @relation("ThresholdFireEvents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([policyId, name])
}

model SlaTimer {
  id       String        @id @default(uuid())
  ticketId String
  ticket   Ticket        @relation("TicketSlaTimers", fields: [ticketId], references: [id], onDelete: Cascade)
  stageId  String
  stage    WorkflowStage @relation("StageSlaTimers", fields: [stageId], references: [id], onDelete: Cascade)
  policyId String
  policy   SlaPolicy     @relation(fields: [policyId], references: [id], onDelete: Restrict)

  // The spawned escalation ticket (running policy.escalationWorkflow). Null if
  // policy.escalationWorkflowId was null at timer-start time. Threshold cron
  // advances this ticket, never the parent.
  escalationTicketId String?
  escalationTicket   Ticket? @relation("TicketAsSlaEscalation", fields: [escalationTicketId], references: [id], onDelete: SetNull)

  status      SlaTimerStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  deadline    DateTime
  completedAt DateTime?

  // Elapsed-time accounting (matches Django's elapsed_before_pause + last_resumed_at
  // pattern): tracks WORKING time elapsed, not paused time. Computed elapsed =
  // elapsedBeforePauseSec + (status in [RUNNING, EXTENDED] ? now() - lastResumedAt : 0).
  // Pause: elapsedBeforePauseSec += (now - lastResumedAt); status=PAUSED; lastResumedAt=null.
  // Resume: lastResumedAt=now(); status=RUNNING (or EXTENDED if extensionCount>0).
  elapsedBeforePauseSec Int       @default(0)
  lastResumedAt         DateTime?

  // Extensions accumulate; status flips RUNNING → EXTENDED on first granted extension.
  totalExtensionsSec Int @default(0)
  extensionCount     Int @default(0)

  events     SlaTimerEvent[]
  extensions SlaExtension[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, deadline])
  @@index([ticketId, status])
  @@index([stageId, status])
  @@index([escalationTicketId])
}

model SlaTimerEvent {
  id          String        @id @default(uuid())
  timerId     String
  timer       SlaTimer      @relation(fields: [timerId], references: [id], onDelete: Cascade)
  eventType   SlaEventType
  thresholdId String?
  threshold   SlaThreshold? @relation("ThresholdFireEvents", fields: [thresholdId], references: [id], onDelete: SetNull)

  // Duplicated from threshold (when applicable) so events stay queryable even
  // if the threshold is later renamed/deleted. `thresholdPercentage` is the
  // ACTUAL elapsed% at fire time, not the configured threshold % — lets the
  // audit log distinguish "fired at 75.3% (threshold was 75%)".
  thresholdName       String?
  thresholdPercentage Float?

  // For EXTENDED events.
  extensionAmountSec Int?
  newDeadline        DateTime?

  // For audit: who caused the event (null for system-driven cron events).
  triggeredById String?
  triggeredBy   User?   @relation("SlaTimerEventTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  eventData   Json?
  occurredAt  DateTime      @default(now())

  createdAt DateTime @default(now())

  @@index([timerId, occurredAt])
  @@index([timerId, eventType])
}

model SlaExtension {
  id      String   @id @default(uuid())
  timerId String
  timer   SlaTimer @relation(fields: [timerId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("SlaExtensionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  approverId String?
  approver   User?   @relation("SlaExtensionApprover", fields: [approverId], references: [id], onDelete: SetNull)

  status       ExtensionStatus @default(PENDING)
  reason       String
  extensionSec Int
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timerId, status])
}
