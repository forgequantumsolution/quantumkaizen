generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  name         String

  employeeId  String? @unique
  firstName   String?
  lastName    String?
  phone       String?
  designation String?

  isActive Boolean @default(true)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id], onDelete: SetNull)

  managerId String?
  manager   User?   @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  reports   User[]  @relation("UserManager")

  joinDate    DateTime?
  lastLoginAt DateTime?
  avatarUrl   String?
  locale      String    @default("en")
  timezone    String    @default("Asia/Kolkata")

  signatureMeaning    String?
  signaturePinHash    String?
  signatureEnrolledAt DateTime?

  headOfDepartments Department[] @relation("DepartmentHead")

  workflowsCreated Workflow[]            @relation("WorkflowCreatedBy")
  workflowsDeleted Workflow[]            @relation("WorkflowDeletedBy")
  stageActions     WorkflowStageAction[] @relation("StageActionAllowedUsers")

  ticketsCreated         Ticket[]              @relation("TicketCreatedBy")
  ticketsDeleted         Ticket[]              @relation("TicketDeletedBy")
  ticketsHeld            Ticket[]              @relation("TicketHeldBy")
  commentsAuthored       TicketComment[]       @relation("TicketCommentAuthor")
  docsUploaded           TicketDoc[]           @relation("TicketDocUploadedBy")
  stageTrackingPerformed TicketStageTracking[] @relation("TicketStageTrackingPerformedBy")

  formsCreated    Form[]           @relation("FormCreatedBy")
  formDraftsSaved FormDraft[]      @relation("FormDraftSavedBy")
  formSubmissions FormSubmission[] @relation("FormSubmissionSubmittedBy")
  auditSchedules  AuditSchedule[]  @relation("AuditScheduleCreatedBy")

  // Audit module (register → program → finding → NC)
  auditMastersCreated     AuditMaster[]    @relation("AuditMasterCreatedBy")
  auditRegistersCreated   AuditRegister[]  @relation("AuditRegisterCreatedBy")
  auditRegistersAsAuditor AuditRegister[]  @relation("AuditRegisterAuditor")
  auditRegistersToApprove AuditRegister[]  @relation("AuditRegisterApprover")
  auditRegistersApproved  AuditRegister[]  @relation("AuditRegisterApprovedBy")
  auditFindingsCreated    AuditFinding[]   @relation("AuditFindingCreatedBy")
  nonConformancesCreated  NonConformance[] @relation("NonConformanceCreatedBy")
  capasOwned              Capa[]           @relation("CapaOwner")
  capasVerified           Capa[]           @relation("CapaVerifiedBy")
  capasCreated            Capa[]           @relation("CapaCreatedBy")
  actionItemsOwned        ActionItem[]     @relation("ActionItemOwner")
  actionItemsCreated      ActionItem[]     @relation("ActionItemCreatedBy")

  // Phase 3 — Approvals + SLA
  approverOnPolicies      ApprovalPolicy[] @relation("ApprovalPolicyApproverUsers")
  approvalRecords         ApprovalRecord[] @relation("UserApprovalRecords")
  slaPolicyResponsibleFor SlaPolicy[]      @relation("SlaPolicyResponsibleUsers")
  slaThresholdNotifyFor   SlaThreshold[]   @relation("SlaThresholdNotifyUsers")
  slaExtensionsRequested  SlaExtension[]   @relation("SlaExtensionRequestedBy")
  slaExtensionsApproved   SlaExtension[]   @relation("SlaExtensionApprover")
  slaTimerEventsTriggered SlaTimerEvent[]  @relation("SlaTimerEventTriggeredBy")

  // Phase 3.5 — stage form bindings
  stageFormBindingsCreated StageFormBinding[] @relation("StageFormBindingCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([roleId])
  @@index([siteId])
  @@index([managerId])
}

model Department {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String  @unique
  description String?

  parentId String?
  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")

  headUserId String?
  head       User?   @relation("DepartmentHead", fields: [headUserId], references: [id], onDelete: SetNull)

  costCenter String?
  isActive   Boolean @default(true)

  users   User[]
  tickets Ticket[] @relation("TicketDepartment")

  nonConformances NonConformance[] @relation("NonConformanceDepartment")
  capas           Capa[]           @relation("CapaDepartment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([headUserId])
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  permissions Permission[] @relation("RolePermissions")
  users       User[]

  stageActions WorkflowStageAction[] @relation("StageActionAllowedRoles")

  // Phase 3 — Approvals + SLA
  approverOnPolicies      ApprovalPolicy[] @relation("ApprovalPolicyApproverRoles")
  approvalRecordsAsRole   ApprovalRecord[] @relation("ApprovalRecordRole")
  slaPolicyResponsibleFor SlaPolicy[]      @relation("SlaPolicyResponsibleRoles")
  slaThresholdNotifyFor   SlaThreshold[]   @relation("SlaThresholdNotifyRoles")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  module      String
  action      String
  description String

  roles Role[] @relation("RolePermissions")

  createdAt DateTime @default(now())

  @@index([module])
}

model Site {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  address  String?
  isActive Boolean @default(true)

  users   User[]
  tickets Ticket[] @relation("TicketSite")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id         String   @id @default(uuid())
  name       String
  tenantCode String   @unique
  industry   String
  website    String?
  address    String?
  standards  String[]
  timezone   String   @default("Asia/Kolkata")
  dateFormat String   @default("DD/MM/YYYY")
  logoUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Workflow domain (Phase 1 — builder layer only; engine/SLA/forms in later phases)
// ─────────────────────────────────────────────────────────────────────────────

enum WorkflowApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WorkflowLifecycleStatus {
  ACTIVE
  INACTIVE
  DRAFT
  DRAFT_UPDATE
}

enum StageType {
  STAGE
  FORK
  JOIN
  DECISION
  AUDIT_FORMS
}

enum SplitType {
  AND
  OR
  XOR
}

enum JoinType {
  AND
  OR
}

enum StageActionBehavior {
  FORWARD
  REJECT
  HOLD
  UNHOLD
  RETURN
  REASSIGN
}

model WorkflowType {
  id         String  @id @default(uuid())
  name       String  @unique
  codePrefix String?
  isDeleted  Boolean @default(false)

  workflows  Workflow[]
  iconConfig WorkflowIconConfig?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowIconConfig {
  id             String       @id @default(uuid())
  workflowTypeId String       @unique
  workflowType   WorkflowType @relation(fields: [workflowTypeId], references: [id], onDelete: Cascade)
  iconName       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowStageStatus {
  id        String              @id @default(uuid())
  name      String              @unique
  behavior  StageActionBehavior @default(FORWARD)
  isDeleted Boolean             @default(false)

  stageActions WorkflowStageAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionType {
  id        String  @id @default(uuid())
  name      String  @unique
  isDeleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActionCriteria {
  id        String  @id @default(uuid())
  name      String
  isDeleted Boolean @default(false)

  stageActions WorkflowStageAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Priority {
  id   String @id @default(uuid())
  name String @unique

  tickets Ticket[]
}

// Severity — industry-standard quality-management lookup, distinct from
// Priority. Priority = urgency / scheduling; Severity = impact / classification
// of the underlying problem. Common values: Critical / Major / Minor.
model Severity {
  id        String  @id @default(uuid())
  name      String  @unique
  level     Int     @default(0) // higher = more severe; lets us sort
  color     String? // hex, used by UI badges
  isDeleted Boolean @default(false)

  tickets Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Ticket classification — a small fixed enum so it can be filtered/grouped
// without an extra lookup table. Open to extension via migration if business
// adds new categories.
enum TicketClassification {
  PRODUCT
  PROCESS
  SYSTEM
  EQUIPMENT
  DOCUMENTATION
  TRAINING
  OTHER
}

model Workflow {
  id   String @id @default(uuid())
  name String

  typeId String?
  type   WorkflowType? @relation(fields: [typeId], references: [id], onDelete: SetNull)

  status         WorkflowApprovalStatus  @default(PENDING)
  workflowStatus WorkflowLifecycleStatus @default(DRAFT)

  totalExecutions      Int       @default(0)
  successfulExecutions Int       @default(0)
  failedExecutions     Int       @default(0)
  lastExecutedAt       DateTime?
  maxExecutionsPerDay  Int?
  timeoutSeconds       Int?

  version         Int     @default(1)
  isLatestVersion Boolean @default(true)

  previousVersionId String?
  previousVersion   Workflow?  @relation("WorkflowVersionChain", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions      Workflow[] @relation("WorkflowVersionChain")

  parentWorkflowId String?
  parentWorkflow   Workflow?  @relation("WorkflowLineage", fields: [parentWorkflowId], references: [id], onDelete: SetNull)
  childWorkflows   Workflow[] @relation("WorkflowLineage")

  draftOfId String?
  draftOf   Workflow?  @relation("WorkflowDraftOf", fields: [draftOfId], references: [id], onDelete: Cascade)
  drafts    Workflow[] @relation("WorkflowDraftOf")

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("WorkflowDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("WorkflowCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  stages      WorkflowStage[]
  transitions WorkflowTransition[]
  temporary   TemporaryWorkflow?

  flows         TicketFlow[]
  childTriggers ChildWorkflowTrigger[] @relation("WorkflowChildTriggers")

  // Phase 3 — Approvals + SLA escalation
  approvalPolicies    ApprovalPolicy[] @relation("WorkflowApprovalPolicies")
  usedAsSlaEscalation SlaPolicy[]      @relation("WorkflowAsSlaEscalation")

  // Phase 3.5 — stage form bindings owned by this workflow
  stageFormBindings StageFormBinding[] @relation("WorkflowStageFormBindings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isLatestVersion, isDeleted])
  @@index([typeId])
  @@index([parentWorkflowId])
  @@index([draftOfId])
}

model WorkflowStage {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  name           String
  canonicalId    String  @default("")
  isInitialStage Boolean @default(false)
  sendEmail      Boolean @default(false)
  additionalData Json?

  stageType StageType  @default(STAGE)
  splitType SplitType?
  joinType  JoinType?

  joinPointId String?
  joinPoint   WorkflowStage?  @relation("StageForkJoin", fields: [joinPointId], references: [id], onDelete: SetNull)
  forkPoints  WorkflowStage[] @relation("StageForkJoin")

  actions             WorkflowStageAction[]
  outgoingTransitions WorkflowTransition[]  @relation("FromStage")
  incomingTransitions WorkflowTransition[]  @relation("ToStage")

  currentForFlows      TicketFlow[]             @relation("TicketFlowCurrentStages")
  stageTracking        TicketStageTracking[]
  parentTickets        Ticket[]                 @relation("TicketParentStage")
  forkBranches         ParallelBranchTracking[] @relation("ForkBranchTracking")
  joinBranches         ParallelBranchTracking[] @relation("JoinBranchTracking")
  childTriggers        ChildWorkflowTrigger[]   @relation("StageChildTriggers")
  docs                 TicketDoc[]              @relation("TicketDocStage")
  returnedFromTracking TicketStageTracking[]    @relation("StageTrackingReturnedFrom")

  // Phase 3 — Approvals + SLA
  approvalPolicies    ApprovalPolicy[] @relation("StageApprovalPolicies")
  slaPolicy           SlaPolicy?       @relation("StageSlaPolicy")
  slaTimers           SlaTimer[]       @relation("StageSlaTimers")
  slaThresholdTargets SlaThreshold[]   @relation("SlaThresholdTargetStage")

  // Phase 3.5 — stage form bindings
  formBindings    StageFormBinding[] @relation("StageFormBindings")
  formSubmissions FormSubmission[]   @relation("StageFormSubmissions")

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workflowId, isInitialStage])
  @@index([canonicalId])
}

model WorkflowStageAction {
  id              String        @id @default(uuid())
  workflowStageId String
  workflowStage   WorkflowStage @relation(fields: [workflowStageId], references: [id], onDelete: Cascade)

  workflowActionId String
  workflowAction   WorkflowStageStatus @relation(fields: [workflowActionId], references: [id], onDelete: Cascade)

  criteriaId String?
  criteria   ActionCriteria? @relation(fields: [criteriaId], references: [id], onDelete: SetNull)

  isPrimary Boolean @default(true)

  allowedRoles Role[] @relation("StageActionAllowedRoles")
  allowedUsers User[] @relation("StageActionAllowedUsers")

  postActionsTracking TicketStageTracking[] @relation("StageTrackingPostAction")

  // Phase 3 — Approvals
  approvalPolicies           ApprovalPolicy[]   @relation("ActionApprovalPolicies")
  triggeredApprovalInstances ApprovalInstance[] @relation("ActionTriggeringInstances")

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workflowStageId, workflowActionId])
}

model WorkflowTransition {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromStageId String
  fromStage   WorkflowStage @relation("FromStage", fields: [fromStageId], references: [id], onDelete: Cascade)

  toStageId String
  toStage   WorkflowStage @relation("ToStage", fields: [toStageId], references: [id], onDelete: Cascade)

  sourcePort  String?
  targetPort  String?
  branchName  String?
  condition   String?
  branchOrder Int     @default(0)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fromStageId])
  @@index([toStageId])
  @@index([workflowId])
}

model TemporaryWorkflow {
  id         String   @id @default(uuid())
  workflowId String   @unique
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  flowJson   Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Ticket domain (Phase 2 — execution; engine layers in src/modules/workflow/engine)
// ─────────────────────────────────────────────────────────────────────────────

enum DocType {
  ATTACHMENT
  EVIDENCE
  REPORT
  FORM_SUBMISSION
  OTHER
}

enum ChildTriggerMode {
  MANUAL
  AUTO
}

enum ParallelBranchStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

model Ticket {
  id           String  @id @default(uuid())
  uniqueId     String  @unique
  title        String
  description  String?
  ticketReason String?

  parentTicketId String?
  parentTicket   Ticket?  @relation("TicketParent", fields: [parentTicketId], references: [id], onDelete: SetNull)
  childTickets   Ticket[] @relation("TicketParent")

  parentTicketStageId String?
  parentTicketStage   WorkflowStage? @relation("TicketParentStage", fields: [parentTicketStageId], references: [id], onDelete: SetNull)

  priorityId String?
  priority   Priority? @relation(fields: [priorityId], references: [id], onDelete: SetNull)

  departmentId String?
  department   Department? @relation("TicketDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  siteId String?
  site   Site?   @relation("TicketSite", fields: [siteId], references: [id], onDelete: SetNull)

  // Severity — industry-standard quality field, separate from Priority.
  severityId String?
  severity   Severity? @relation(fields: [severityId], references: [id], onDelete: SetNull)

  // Target completion / due date for the ticket. Independent of SLA timers —
  // this is the date the user committed to closing the ticket by.
  dueDate DateTime?

  // Optional category to slice analytics (product / process / system / etc.).
  classification TicketClassification?

  customFields Json?

  isOnHold   Boolean   @default(false)
  holdReason String?
  heldAt     DateTime?
  heldById   String?
  heldBy     User?     @relation("TicketHeldBy", fields: [heldById], references: [id], onDelete: SetNull)

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("TicketDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("TicketCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  flows            TicketFlow[]
  comments         TicketComment[]
  docs             TicketDoc[]
  stageTracking    TicketStageTracking[]
  parallelTracking ParallelBranchTracking[]

  // Phase 3 — Approvals + SLA
  approvalInstances     ApprovalInstance[] @relation("TicketApprovalInstances")
  slaTimers             SlaTimer[]         @relation("TicketSlaTimers")
  // Back-relation for SlaTimer.escalationTicket — set when this ticket IS the
  // spawned escalation child (so we can query "is this an SLA-escalation ticket?").
  slaTimersAsEscalation SlaTimer[]         @relation("TicketAsSlaEscalation")

  // Phase 3.5 — workflow-bound form submissions
  formSubmissions FormSubmission[] @relation("TicketFormSubmissions")

  // Audit module — set when this ticket is a CAPA ticket spawned from a
  // non-conformance. Allows back-references from NC list views.
  nonConformanceCapa NonConformance? @relation("NonConformanceCapaTicket")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([uniqueId])
  @@index([createdById, createdAt])
  @@index([priorityId, createdAt])
  @@index([isDeleted, createdAt])
  @@index([parentTicketId, isDeleted])
}

model TicketFlow {
  id         String   @id @default(uuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Restrict)

  workflowName    String
  workflowVersion Int

  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  statusUpdatedAt DateTime  @default(now())

  currentStages WorkflowStage[] @relation("TicketFlowCurrentStages")

  // Phase 3.5 — workflow-bound form submissions on this flow
  formSubmissions FormSubmission[] @relation("TicketFlowFormSubmissions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ticketId, workflowId])
  @@index([workflowId, isCompleted])
  @@index([ticketId, isCompleted])
}

model TicketStageTracking {
  id       String         @id @default(uuid())
  ticketId String
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  stageId  String?
  stage    WorkflowStage? @relation(fields: [stageId], references: [id], onDelete: SetNull)

  stageName       String
  stageWorkflowId String

  enteredAt   DateTime  @default(now())
  exitedAt    DateTime?
  durationSec Int?

  isActive   Boolean @default(true)
  isOnHold   Boolean @default(false)
  holdReason String?

  performedById String?
  performedBy   User?   @relation("TicketStageTrackingPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  postActionId String?
  postAction   WorkflowStageAction? @relation("StageTrackingPostAction", fields: [postActionId], references: [id], onDelete: SetNull)

  returnedFromStageId String?
  returnedFromStage   WorkflowStage? @relation("StageTrackingReturnedFrom", fields: [returnedFromStageId], references: [id], onDelete: SetNull)

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, stageId, isActive])
  @@index([ticketId, isActive])
  @@index([stageWorkflowId, isActive])
  @@index([enteredAt])
}

model TicketComment {
  id       String @id @default(uuid())
  ticketId String
  ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  body     String
  authorId String?
  author   User?   @relation("TicketCommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

model TicketDoc {
  id       String         @id @default(uuid())
  ticketId String
  ticket   Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  stageId  String?
  stage    WorkflowStage? @relation("TicketDocStage", fields: [stageId], references: [id], onDelete: SetNull)

  fileUrl       String
  fileName      String
  mimeType      String?
  fileSizeBytes Int?
  docType       DocType @default(ATTACHMENT)

  uploadedById String?
  uploadedBy   User?   @relation("TicketDocUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, createdAt])
}

model ChildWorkflowTrigger {
  id              String           @id @default(uuid())
  parentStageId   String
  parentStage     WorkflowStage    @relation("StageChildTriggers", fields: [parentStageId], references: [id], onDelete: Cascade)
  childWorkflowId String
  childWorkflow   Workflow         @relation("WorkflowChildTriggers", fields: [childWorkflowId], references: [id], onDelete: Restrict)
  triggerMode     ChildTriggerMode @default(MANUAL)
  isBlocking      Boolean          @default(false)
  allowMultiple   Boolean          @default(false)
  order           Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ParallelBranchTracking {
  id          String         @id @default(uuid())
  ticketId    String
  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  forkStageId String
  forkStage   WorkflowStage  @relation("ForkBranchTracking", fields: [forkStageId], references: [id], onDelete: Cascade)
  joinStageId String?
  joinStage   WorkflowStage? @relation("JoinBranchTracking", fields: [joinStageId], references: [id], onDelete: SetNull)

  branchPath  Json
  status      ParallelBranchStatus @default(ACTIVE)
  startedAt   DateTime             @default(now())
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, forkStageId, status])
}

// =====================================================================
// Phase 3.5 — Stage ↔ Form bindings
// =====================================================================

// A StageFormBinding declares "this form must (or may) be submitted on this
// stage before the ticket can transition out". Bindings reference the
// logical `Form` (templateKey), not a pinned version — the latest version is
// what's served at fill time. See docs/WORKFLOW_PHASE_3_5_PLAN.md §3.
model StageFormBinding {
  id         String   @id @default(uuid())
  workflowId String
  workflow   Workflow @relation("WorkflowStageFormBindings", fields: [workflowId], references: [id], onDelete: Cascade)

  stageId String
  stage   WorkflowStage @relation("StageFormBindings", fields: [stageId], references: [id], onDelete: Cascade)

  formId String
  form   Form   @relation("FormStageFormBindings", fields: [formId], references: [id], onDelete: Restrict)

  isRequired Boolean @default(true)
  position   Int     @default(0)

  isActive  Boolean @default(true)
  isDeleted Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?
  createdBy   User?    @relation("StageFormBindingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  submissions FormSubmission[] @relation("FormSubmissionBinding")

  @@unique([stageId, formId])
  @@index([workflowId, stageId])
  @@index([formId])
}

// =====================================================================
// Dynamic Form Builder
// =====================================================================

enum FormStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FormKind {
  FORM
  CHECKLIST
}

enum FormSubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

// User-extensible field type registry. Built-ins (text, number, select,
// table, signature, ...) are seeded; users can add their own via
// FieldTypeManager.
model FieldType {
  id          String  @id @default(uuid())
  name        String  @unique // machine name e.g. "text", "select"
  label       String // display name
  description String?
  dataType    String? // primitive: string|number|boolean|date|json|file
  isSystem    Boolean @default(false)
  isActive    Boolean @default(true)
  config      Json? // default validation/options blob

  fields FormField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Checklist categories: Audit, Inspection, Calibration, etc.
model FormType {
  id        String  @id @default(uuid())
  name      String  @unique
  versionId String  @unique // immutable identifier per version, exposed to FE
  isActive  Boolean @default(true)

  forms Form[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A versioned form template. Each version is a separate row sharing a
// templateKey so the FE can list `all_versions`.
model Form {
  id          String     @id @default(uuid())
  templateKey String // groups versions of the same logical form
  title       String
  description String?
  version     Int        @default(1)
  versionId   String     @unique // immutable per version
  status      FormStatus @default(DRAFT)
  kind        FormKind   @default(FORM)
  isCompleted Boolean    @default(false)

  formTypeId String?
  formType   FormType? @relation(fields: [formTypeId], references: [id], onDelete: SetNull)

  // Optional PDCA / audit context
  location     String?
  mainProcess  String?
  criteria     String?
  pdcaApproved Boolean @default(false)

  workflowName String?
  workflowType String?

  createdById String?
  createdBy   User?   @relation("FormCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  sections    FormSection[]
  draft       FormDraft?
  submissions FormSubmission[]

  // Phase 3.5 — bindings linking this form to workflow stages
  stageBindings StageFormBinding[] @relation("FormStageFormBindings")

  // Audit module — back-relations when this form is used as a checklist
  auditMasterDefaultFor     AuditMaster[]   @relation("AuditMasterDefaultChecklist")
  auditRegisterChecklistFor AuditRegister[] @relation("AuditRegisterChecklist")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([templateKey, version])
  @@index([formTypeId])
  @@index([status])
  @@index([kind, status])
}

model FormSection {
  id         String @id @default(uuid())
  sectionId  String // FE-side identifier
  name       String
  position   Int    @default(0)
  dependency Json? // conditional visibility rules

  formId String
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  fields FormField[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, position])
}

model FormField {
  id       String  @id @default(uuid())
  fieldId  String // FE-side identifier used in submission payloads
  name     String // unique within section, used as JSON key
  label    String
  position Int     @default(0)
  width    String  @default("100") // 25/33/50/66/75/100 grid
  required Boolean @default(false)

  // Field type — by id (preferred) or by name string for legacy/built-in
  typeId   String?
  type     FieldType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  typeName String?

  defaultValue Json?
  options      Json? // [{label, value}]
  validation   Json? // arbitrary validation blob (see FE validationRules)
  dependency   Json? // conditional visibility

  // Dynamic / API-driven options
  dynamic  Boolean @default(false)
  endpoint String?

  // Auto-generate from API
  autoGenerate         Boolean @default(false)
  autoGenerateEndpoint String?
  autoGenerateMappings Json?

  sectionId String
  section   FormSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  // Nested fields for table-type (parent has type=table)
  parentFieldId String?
  parentField   FormField?  @relation("FormFieldChildren", fields: [parentFieldId], references: [id], onDelete: Cascade)
  children      FormField[] @relation("FormFieldChildren")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId, position])
  @@index([parentFieldId])
}

// Single freeform draft snapshot per form (overwritten on every save).
model FormDraft {
  id     String @id @default(uuid())
  formId String @unique
  form   Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  draftData   Json
  formDetails Json
  versionId   String?

  savedById String?
  savedBy   User?   @relation("FormDraftSavedBy", fields: [savedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A filled-in form response.
model FormSubmission {
  id        String @id @default(uuid())
  formId    String
  form      Form   @relation(fields: [formId], references: [id], onDelete: Cascade)
  versionId String

  status    FormSubmissionStatus @default(IN_PROGRESS)
  responses Json // { sectionName: { fieldName: value } }
  meta      Json? // arbitrary attachments / context

  submittedById String?
  submittedBy   User?     @relation("FormSubmissionSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  // Phase 3.5 — workflow-bound submissions. All nullable so standalone fills
  // continue to work. Populated by the workflow-scoped POST endpoint at
  // /api/tickets/:id/forms/:formId/submissions.
  ticketId  String?
  ticket    Ticket?           @relation("TicketFormSubmissions", fields: [ticketId], references: [id], onDelete: SetNull)
  stageId   String?
  stage     WorkflowStage?    @relation("StageFormSubmissions", fields: [stageId], references: [id], onDelete: SetNull)
  flowId    String?
  flow      TicketFlow?       @relation("TicketFlowFormSubmissions", fields: [flowId], references: [id], onDelete: SetNull)
  bindingId String?
  binding   StageFormBinding? @relation("FormSubmissionBinding", fields: [bindingId], references: [id], onDelete: SetNull)

  // Audit module — set when this submission IS an audit program's filled checklist
  auditProgramChecklistFor AuditProgram[] @relation("AuditProgramChecklistSubmission")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([formId, status])
  @@index([submittedById])
  @@index([ticketId, stageId])
  @@index([bindingId])
}

// =====================================================================
// ISO standards / audit checklists
// =====================================================================

model IsoStandard {
  id       String  @id @default(uuid())
  name     String  @unique
  remarks  String?
  isActive Boolean @default(true)

  clauses IsoClause[]

  // Audit module — back-relations
  auditMasters   AuditMaster[]
  auditRegisters AuditRegister[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IsoClause {
  id           String @id @default(uuid())
  clauseNumber String
  clauseTitle  String
  position     Int    @default(0)

  standardId String
  standard   IsoStandard @relation(fields: [standardId], references: [id], onDelete: Cascade)

  subClauses IsoSubClause[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([standardId, position])
}

model IsoSubClause {
  id              String  @id @default(uuid())
  subClauseNumber String
  subClauseTitle  String
  requirementText String?
  position        Int     @default(0)

  clauseId String
  clause   IsoClause @relation(fields: [clauseId], references: [id], onDelete: Cascade)

  // Audit module — back-relation when a finding cites this sub-clause
  findings AuditFinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clauseId, position])
}

model AuditSchedule {
  id                String    @id @default(uuid())
  title             String
  plant             String?
  description       String?
  auditDate         DateTime
  previousAuditDate DateTime?
  financialYear     String?
  auditMethod       String?
  isActive          Boolean   @default(true)

  // Free-form arrays of {id, name} kept as JSON to avoid coupling to other modules
  locations     Json?
  mainProcesses Json?
  subProcesses  Json?
  criteria      Json?
  departments   Json?
  focusAreas    Json?

  createdById String?
  createdBy   User?   @relation("AuditScheduleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([financialYear])
  @@index([auditDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 3 — Approvals + SLA
// Plan: docs/WORKFLOW_PHASE_3_PLAN.md
// Migration: 20260512161347_workflow_phase3_approvals_sla
// ─────────────────────────────────────────────────────────────────────────────

enum ApprovalMode {
  SINGLE
  ALL_REQUIRED
  QUORUM
  SEQUENTIAL
  ANY
}

// Match Django's instance lifecycle: a policy is "SATISFIED" when its mode's
// quorum/sequence rule is met (not just one approval). `INVALIDATED` lets
// admins void an in-flight instance when the policy itself is edited, with
// reason captured on the instance.
enum ApprovalInstanceStatus {
  PENDING
  SATISFIED
  REJECTED
  EXPIRED
  INVALIDATED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

// `RUNNING` = clock active, no extensions granted; `EXTENDED` = clock active
// and at least one extension has been granted (distinct so the UI can badge it).
enum SlaTimerStatus {
  RUNNING
  PAUSED
  EXTENDED
  COMPLETED
  BREACHED
}

// `SLA_TRANSITION` = the escalation ticket was auto-advanced by the threshold
// sweep (the parent ticket is never moved by SLA cron — see SlaPolicy.escalationWorkflow).
// `COMPLETED_LATE` = parent stage exited *after* deadline passed (status went
// BREACHED first, then exited cleanly).
enum SlaEventType {
  STARTED
  PAUSED
  RESUMED
  THRESHOLD_HIT
  SLA_TRANSITION
  EXTENDED
  COMPLETED
  COMPLETED_LATE
  BREACHED
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Approvals (3 tables) ──────────────────────────────────────────────────

model ApprovalPolicy {
  id         String              @id @default(uuid())
  workflowId String
  workflow   Workflow            @relation("WorkflowApprovalPolicies", fields: [workflowId], references: [id], onDelete: Cascade)
  stageId    String
  stage      WorkflowStage       @relation("StageApprovalPolicies", fields: [stageId], references: [id], onDelete: Cascade)
  actionId   String
  action     WorkflowStageAction @relation("ActionApprovalPolicies", fields: [actionId], references: [id], onDelete: Cascade)

  mode                   ApprovalMode
  requiredCount          Int          @default(1)
  // `strictRoleMatch=true` means "approver's role must be exactly in approverRoles"
  // (ignore role hierarchy). Default false = honor hierarchy (head-of-dept can
  // approve for an underling's role).
  strictRoleMatch        Boolean      @default(false)
  allowSelfApproval      Boolean      @default(false)
  requireUniqueApprovers Boolean      @default(true)
  // For mode=SEQUENTIAL — ordered list of `{ order, role_id | user_id, label }`.
  approvalSequence       Json?
  approvalSlaHours       Int?

  // `isActive=false` retires a policy without deleting it (preserves history
  // via existing ApprovalInstance rows). `isDeleted` is the soft-delete tombstone.
  isActive Boolean @default(true)

  approverRoles Role[] @relation("ApprovalPolicyApproverRoles")
  approverUsers User[] @relation("ApprovalPolicyApproverUsers")

  instances ApprovalInstance[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([stageId, actionId])
  @@index([workflowId])
}

model ApprovalInstance {
  id                 String               @id @default(uuid())
  ticketId           String
  ticket             Ticket               @relation("TicketApprovalInstances", fields: [ticketId], references: [id], onDelete: Cascade)
  policyId           String
  policy             ApprovalPolicy       @relation(fields: [policyId], references: [id], onDelete: Restrict)
  triggeringActionId String?
  triggeringAction   WorkflowStageAction? @relation("ActionTriggeringInstances", fields: [triggeringActionId], references: [id], onDelete: SetNull)

  status               ApprovalInstanceStatus @default(PENDING)
  startedAt            DateTime               @default(now())
  completedAt          DateTime?
  deadlineAt           DateTime?
  // For SEQUENTIAL mode: which step in the approval_sequence we're waiting on.
  currentSequenceOrder Int                    @default(1)

  // When status=INVALIDATED — captures who/why so audit can explain why an
  // in-flight instance was voided (typically because the underlying policy
  // changed mid-approval and a fresh instance had to be opened).
  invalidatedAt     DateTime?
  invalidatedReason String?

  records ApprovalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ticketId, status])
  @@index([policyId, status])
  @@index([deadlineAt])
}

model ApprovalRecord {
  id         String           @id @default(uuid())
  instanceId String
  instance   ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  approverId String
  approver   User             @relation("UserApprovalRecords", fields: [approverId], references: [id], onDelete: Restrict)

  // Audit trail of which role the approver acted under — matters when a user
  // holds multiple roles and the policy allows any of them.
  approvedAsRoleId String?
  approvedAsRole   Role?   @relation("ApprovalRecordRole", fields: [approvedAsRoleId], references: [id], onDelete: SetNull)

  decision  ApprovalDecision
  comment   String?
  decidedAt DateTime         @default(now())

  // For SEQUENTIAL mode — which step in the sequence this record satisfied.
  sequenceOrder Int @default(0)

  // Phase-4 e-signature link (no FK target yet — the WorkflowStageSignature
  // model lands in Phase 4. Field reserved so Phase 4 can attach without
  // re-migrating this table).
  stageSignatureId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([instanceId, approverId])
  @@index([instanceId])
}

// ─── SLA (6 tables) ────────────────────────────────────────────────────────

model BusinessCalendar {
  id             String  @id @default(uuid())
  name           String  @unique
  timezone       String  @default("Asia/Kolkata")
  weeklySchedule Json
  holidays       Json
  isActive       Boolean @default(true)
  isDeleted      Boolean @default(false)

  policies SlaPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SlaPolicy {
  id            String        @id @default(uuid())
  parentStageId String        @unique
  parentStage   WorkflowStage @relation("StageSlaPolicy", fields: [parentStageId], references: [id], onDelete: Cascade)

  duration                Int
  calendarId              String?
  calendar                BusinessCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  pauseOnHold             Boolean           @default(true)
  pauseOnExtensionPending Boolean           @default(false)

  // Escalation workflow that gets spawned as a CHILD ticket when the parent
  // ticket enters this stage. The threshold cron only ever advances that
  // child — the parent ticket is never auto-moved by SLA. If null, no
  // escalation ticket is spawned (thresholds fire events only, for notifications).
  escalationWorkflowId String?
  escalationWorkflow   Workflow? @relation("WorkflowAsSlaEscalation", fields: [escalationWorkflowId], references: [id], onDelete: SetNull)

  responsibleRoles Role[] @relation("SlaPolicyResponsibleRoles")
  responsibleUsers User[] @relation("SlaPolicyResponsibleUsers")

  thresholds SlaThreshold[]
  timers     SlaTimer[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calendarId])
  @@index([escalationWorkflowId])
}

model SlaThreshold {
  id       String    @id @default(uuid())
  policyId String
  policy   SlaPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  // Human-readable name surfaced in UI/events (e.g. 'warning', 'critical', 'breach').
  // Required so events can be queried by name regardless of percentage tweaks.
  name       String
  // Float instead of Int — Django uses float so fractional thresholds like 33.3% work.
  percentage Float

  // Target stage in the ESCALATION workflow (not the parent workflow). When
  // the threshold fires, the spawned escalation ticket is moved to this stage.
  // If null, the threshold only fires an event (notification-only).
  targetSlaStageId String?
  targetSlaStage   WorkflowStage? @relation("SlaThresholdTargetStage", fields: [targetSlaStageId], references: [id], onDelete: SetNull)

  notifyRoles Role[] @relation("SlaThresholdNotifyRoles")
  notifyUsers User[] @relation("SlaThresholdNotifyUsers")

  events SlaTimerEvent[] @relation("ThresholdFireEvents")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([policyId, name])
}

model SlaTimer {
  id       String        @id @default(uuid())
  ticketId String
  ticket   Ticket        @relation("TicketSlaTimers", fields: [ticketId], references: [id], onDelete: Cascade)
  stageId  String
  stage    WorkflowStage @relation("StageSlaTimers", fields: [stageId], references: [id], onDelete: Cascade)
  policyId String
  policy   SlaPolicy     @relation(fields: [policyId], references: [id], onDelete: Restrict)

  // The spawned escalation ticket (running policy.escalationWorkflow). Null if
  // policy.escalationWorkflowId was null at timer-start time. Threshold cron
  // advances this ticket, never the parent.
  escalationTicketId String?
  escalationTicket   Ticket? @relation("TicketAsSlaEscalation", fields: [escalationTicketId], references: [id], onDelete: SetNull)

  status      SlaTimerStatus @default(RUNNING)
  startedAt   DateTime       @default(now())
  deadline    DateTime
  completedAt DateTime?

  // Elapsed-time accounting (matches Django's elapsed_before_pause + last_resumed_at
  // pattern): tracks WORKING time elapsed, not paused time. Computed elapsed =
  // elapsedBeforePauseSec + (status in [RUNNING, EXTENDED] ? now() - lastResumedAt : 0).
  // Pause: elapsedBeforePauseSec += (now - lastResumedAt); status=PAUSED; lastResumedAt=null.
  // Resume: lastResumedAt=now(); status=RUNNING (or EXTENDED if extensionCount>0).
  elapsedBeforePauseSec Int       @default(0)
  lastResumedAt         DateTime?

  // Extensions accumulate; status flips RUNNING → EXTENDED on first granted extension.
  totalExtensionsSec Int @default(0)
  extensionCount     Int @default(0)

  events     SlaTimerEvent[]
  extensions SlaExtension[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, deadline])
  @@index([ticketId, status])
  @@index([stageId, status])
  @@index([escalationTicketId])
}

model SlaTimerEvent {
  id          String        @id @default(uuid())
  timerId     String
  timer       SlaTimer      @relation(fields: [timerId], references: [id], onDelete: Cascade)
  eventType   SlaEventType
  thresholdId String?
  threshold   SlaThreshold? @relation("ThresholdFireEvents", fields: [thresholdId], references: [id], onDelete: SetNull)

  // Duplicated from threshold (when applicable) so events stay queryable even
  // if the threshold is later renamed/deleted. `thresholdPercentage` is the
  // ACTUAL elapsed% at fire time, not the configured threshold % — lets the
  // audit log distinguish "fired at 75.3% (threshold was 75%)".
  thresholdName       String?
  thresholdPercentage Float?

  // For EXTENDED events.
  extensionAmountSec Int?
  newDeadline        DateTime?

  // For audit: who caused the event (null for system-driven cron events).
  triggeredById String?
  triggeredBy   User?   @relation("SlaTimerEventTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  eventData  Json?
  occurredAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([timerId, occurredAt])
  @@index([timerId, eventType])
}

model SlaExtension {
  id      String   @id @default(uuid())
  timerId String
  timer   SlaTimer @relation(fields: [timerId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   User   @relation("SlaExtensionRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)

  approverId String?
  approver   User?   @relation("SlaExtensionApprover", fields: [approverId], references: [id], onDelete: SetNull)

  status       ExtensionStatus @default(PENDING)
  reason       String
  extensionSec Int
  decidedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([timerId, status])
}

// =====================================================================
// Audit module — Register → Approval → Program → Findings → Non-Conformance → CAPA
// Industry-standard flow (Honeywell-style). The legacy AuditSchedule model
// is retained for backward compatibility; new work goes through AuditRegister.
// =====================================================================

enum AuditStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum AuditType {
  INTERNAL
  EXTERNAL
  SUPPLIER
  PROCESS
  PRODUCT
  SYSTEM
  COMPLIANCE
}

enum AuditFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
}

enum AuditProgramStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FindingSeverity {
  OBSERVATION
  MINOR
  MAJOR
  CRITICAL
}

enum FindingStatus {
  OPEN
  IN_REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

enum NonConformanceStatus {
  OPEN
  CAPA_RAISED
  IN_PROGRESS
  VERIFICATION
  CLOSED
  CANCELLED
}

// Audit configuration / template. The "Audit Master" sidebar entry edits these.
model AuditMaster {
  id          String  @id @default(uuid())
  code        String? @unique
  name        String
  description String?

  auditType AuditType
  frequency AuditFrequency @default(ANNUAL)

  defaultIsoStandardId String?
  defaultIsoStandard   IsoStandard? @relation(fields: [defaultIsoStandardId], references: [id], onDelete: SetNull)

  // Primary checklist (first of the selection) kept for single-checklist consumers
  // like the audit-register prefill; the full multi-select is stored in checklistForms.
  defaultChecklistFormId String?
  defaultChecklistForm   Form?   @relation("AuditMasterDefaultChecklist", fields: [defaultChecklistFormId], references: [id], onDelete: SetNull)

  // Multiple checklists selectable on the master — JSON snapshot of [{ id, title }].
  checklistForms Json?

  scoringRules Json?
  isActive     Boolean @default(true)

  registers     AuditRegister[]
  scheduleRules AuditScheduleRule[]

  createdById String?
  createdBy   User?   @relation("AuditMasterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([auditType])
  @@index([isActive])
}

// A recurrence rule that auto-spawns DRAFT AuditRegisters from a master on a
// cadence. A background sweep (jobs/sweeps/spawnDueAudits) advances nextRunAt.
model AuditScheduleRule {
  id            String         @id @default(uuid())
  name          String
  auditMasterId String
  auditMaster   AuditMaster    @relation(fields: [auditMasterId], references: [id], onDelete: Cascade)
  frequency     AuditFrequency
  anchorDate    DateTime
  leadTimeDays  Int            @default(14) // create the register N days before the planned date
  plant         String?
  // Optional workflow the spawned audit follows. When set, the schedule sweep
  // raises a workflow ticket (carrying the stage checklist + progress) and
  // links it on the generated AuditRegister.
  workflowId    String?
  // Optional checklist form selected at schedule time. Copied onto each
  // generated audit's checklistFormId so it's the checklist used when the
  // audit is performed.
  checklistFormId String?
  // Stored as plain columns (no FK) to keep this migration self-contained.
  defaultAuditorId String?
  isActive         Boolean   @default(true)
  lastSpawnedAt    DateTime?
  nextRunAt        DateTime
  createdById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([isActive, nextRunAt])
  @@index([auditMasterId])
}

// Audit "Focus Area" master — reusable lookup for audit scoping (Audit Master config tab).
model FocusArea {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// Audit "Audit Type" master — reusable lookup describing audit categories (Audit Master config tab).
model AuditTypeMaster {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

// A planned audit. Goes through approval, then spawns a single AuditProgram on approval.
model AuditRegister {
  id             String @id @default(uuid())
  registerNumber String @unique
  title          String

  status AuditStatus @default(DRAFT)

  auditMasterId String?
  auditMaster   AuditMaster? @relation(fields: [auditMasterId], references: [id], onDelete: SetNull)

  // Free-form to allow the configured "Audit Type" master to drive this value.
  auditType   String
  plant       String?
  description String?

  plannedDate       DateTime
  previousAuditDate DateTime?
  financialYear     String?
  auditMethod       String?

  isoStandardId String?
  isoStandard   IsoStandard? @relation(fields: [isoStandardId], references: [id], onDelete: SetNull)

  // Free-form scoping arrays (kept as JSON to mirror AuditSchedule's pattern)
  locations     Json?
  mainProcesses Json?
  subProcesses  Json?
  criteria      Json?
  departments   Json?
  focusAreas    Json?

  // Audit team members — JSON snapshot of [{ id, name }].
  teamMembers Json?
  // Per-checklist member assignments — [{ checklist_form_id, checklist_title, members: [{ id, name }] }].
  checklistAssignments Json?

  // Default checklist bound at register time (cloned/instantiated at program start)
  checklistFormId String?
  checklistForm   Form?   @relation("AuditRegisterChecklist", fields: [checklistFormId], references: [id], onDelete: SetNull)

  // Workflow integration — when an audit is generated from a schedule rule that
  // specifies a workflow, a ticket is raised on it. These columns link the
  // audit to that ticket so its stage progress + checklist can be surfaced.
  workflowId             String?
  workflowTicketId       String?
  workflowTicketUniqueId String?

  auditorId String?
  auditor   User?   @relation("AuditRegisterAuditor", fields: [auditorId], references: [id], onDelete: SetNull)

  // Inline approver fields. Richer multi-step approval can later plug in via
  // the ApprovalPolicy/ApprovalInstance machinery without breaking these.
  approverId      String?
  approver        User?     @relation("AuditRegisterApprover", fields: [approverId], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  approvedAt      DateTime?
  approvedById    String?
  approvedBy      User?     @relation("AuditRegisterApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectionReason String?

  program AuditProgram?

  createdById String?
  createdBy   User?   @relation("AuditRegisterCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([plannedDate])
  @@index([auditMasterId])
  @@index([financialYear])
}

// Execution record. One per register (1-1). Filled checklist is captured as a FormSubmission.
model AuditProgram {
  id            String @id @default(uuid())
  programNumber String @unique

  registerId String        @unique
  register   AuditRegister @relation(fields: [registerId], references: [id], onDelete: Cascade)

  status AuditProgramStatus @default(PLANNED)

  startedAt   DateTime?
  completedAt DateTime?

  checklistSubmissionId String?
  checklistSubmission   FormSubmission? @relation("AuditProgramChecklistSubmission", fields: [checklistSubmissionId], references: [id], onDelete: SetNull)

  summary String?
  score   Float?

  findings AuditFinding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// A finding recorded against a program. May be promoted to a NonConformance.
model AuditFinding {
  id            String @id @default(uuid())
  findingNumber String @unique

  programId String
  program   AuditProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  severity FindingSeverity
  status   FindingStatus   @default(OPEN)

  clauseRef      String?
  isoSubClauseId String?
  isoSubClause   IsoSubClause? @relation(fields: [isoSubClauseId], references: [id], onDelete: SetNull)

  description    String
  evidence       Json?
  recommendation String?

  nonConformance NonConformance?
  actionItems    ActionItem[]    @relation("ActionItemFinding")

  createdById String?
  createdBy   User?   @relation("AuditFindingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([programId])
  @@index([status])
}

// A non-conformance tracked through to CAPA closure. `track` powers the
// "track-wise" tabs (e.g. by department, by auditor).
model NonConformance {
  id       String @id @default(uuid())
  ncNumber String @unique

  findingId String       @unique
  finding   AuditFinding @relation(fields: [findingId], references: [id], onDelete: Cascade)

  status   NonConformanceStatus @default(OPEN)
  severity FindingSeverity
  track    String?

  departmentId String?
  department   Department? @relation("NonConformanceDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  // Legacy bridge: link to a generic workflow Ticket used as CAPA. Kept for
  // backward-compat; the first-class Capa model below is the preferred path.
  capaTicketId String? @unique
  capaTicket   Ticket? @relation("NonConformanceCapaTicket", fields: [capaTicketId], references: [id], onDelete: SetNull)

  // First-class CAPA raised from this non-conformance (1-1).
  capa        Capa?        @relation("CapaNonConformance")
  actionItems ActionItem[] @relation("ActionItemNc")

  dueDate  DateTime?
  closedAt DateTime?

  createdById String?
  createdBy   User?   @relation("NonConformanceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([track])
  @@index([departmentId])
}

// ============================================================
// CAPA (Corrective & Preventive Action) — first-class object.
// Raised from a NonConformance (or standalone), runs its own lifecycle,
// owns ActionItems, and on closure can drive the source NC to closure.
// ============================================================

enum CapaType {
  CORRECTIVE
  PREVENTIVE
  BOTH
}

enum CapaStatus {
  OPEN
  INVESTIGATION
  PLAN
  IMPLEMENTATION
  VERIFICATION
  CLOSED
  CANCELLED
}

model Capa {
  id          String     @id @default(uuid())
  capaNumber  String     @unique // CAPA-YYYY-XXXX
  type        CapaType   @default(CORRECTIVE)
  status      CapaStatus @default(OPEN)
  title       String
  description String?

  // Origin non-conformance (optional — a CAPA may be standalone). 1-1.
  nonConformanceId String?         @unique
  nonConformance   NonConformance? @relation("CapaNonConformance", fields: [nonConformanceId], references: [id], onDelete: SetNull)

  // Root cause analysis. rootCauseData holds structured 5-why / fishbone.
  rootCause        String?
  rootCauseData    Json?
  correctiveAction String?
  preventiveAction String?

  ownerId      String?
  owner        User?       @relation("CapaOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  departmentId String?
  department   Department? @relation("CapaDepartment", fields: [departmentId], references: [id], onDelete: SetNull)

  dueDate            DateTime?
  implementedAt      DateTime?
  // Effectiveness verification.
  verifiedById       String?
  verifiedBy         User?     @relation("CapaVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt         DateTime?
  effectivenessCheck String?
  effectivenessDue   DateTime?
  closedAt           DateTime?

  actionItems ActionItem[] @relation("ActionItemCapa")

  createdById String?
  createdBy   User?    @relation("CapaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([departmentId])
}

// A lightweight, assignable task. Hangs off a CAPA, NC or finding (any/none).
model ActionItem {
  id           String             @id @default(uuid())
  actionNumber String             @unique // AI-YYYY-XXXX
  title        String
  description  String?
  status       ActionItemStatus   @default(OPEN)
  priority     ActionItemPriority @default(MEDIUM)

  ownerId     String?
  owner       User?     @relation("ActionItemOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueDate     DateTime?
  completedAt DateTime?

  // Optional parents — an action item can be attached to one of these.
  capaId           String?
  capa             Capa?           @relation("ActionItemCapa", fields: [capaId], references: [id], onDelete: Cascade)
  nonConformanceId String?
  nonConformance   NonConformance? @relation("ActionItemNc", fields: [nonConformanceId], references: [id], onDelete: SetNull)
  findingId        String?
  finding          AuditFinding?   @relation("ActionItemFinding", fields: [findingId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("ActionItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, dueDate])
  @@index([ownerId])
  @@index([capaId])
}

enum ActionItemStatus {
  OPEN
  IN_PROGRESS
  DONE
  VERIFIED
  CANCELLED
}

enum ActionItemPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ============================================================
// Compliance: immutable audit trail + 21 CFR Part 11 e-signatures.
// Both are append-only (no update/delete service paths). userName is
// denormalized so the record survives user deletion. userId kept as a
// plain column (no FK) so this stays self-contained.
// ============================================================

model AuditTrailEntry {
  id         String   @id @default(uuid())
  entityType String // "Capa" | "AuditRegister" | "NonConformance" | ...
  entityId   String
  action     String // CREATE | UPDATE | TRANSITION | SIGN | DELETE
  field      String?
  oldValue   String?
  newValue   String?
  reason     String?
  userId     String?
  userName   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ESignature {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  meaning    String // "Approved" | "Reviewed" | "Verified & Closed" | ...
  userId     String
  userName   String
  signedAt   DateTime @default(now())

  @@index([entityType, entityId])
}

// ─────────────────────────── DMS — Controlled Documents ───────────────────────────
// A controlled-document repository (SOPs, policies, protocols…) distinct from the
// data-capture Form module. Content is authored in the online editor and stored as
// HTML on each version. User/Department refs are plain id columns (no FK) to keep the
// migration self-contained, mirroring AuditScheduleRule. Names are resolved in-service.

enum DocumentType {
  SOP
  POLICY
  PROTOCOL
  WORK_INSTRUCTION
  FORM_TEMPLATE
  MANUAL
  SPECIFICATION
  OTHER
}

enum DocumentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  EFFECTIVE
  SUPERSEDED
  RETIRED
}

// How a version's content is authored: the online rich-text editor, or an
// uploaded file (stored inline as a base64 data URL — no external storage infra).
enum DocContentType {
  EDITOR
  FILE
}

model Document {
  id          String         @id @default(uuid())
  docNumber   String         @unique
  title       String
  type        DocumentType   @default(SOP)
  status      DocumentStatus @default(DRAFT)
  description String?

  departmentId String?
  ownerId      String?
  // Points at the DocumentVersion currently in force (plain id — avoids a second
  // Document↔DocumentVersion relation).
  currentVersionId String?

  effectiveDate DateTime?
  reviewDueDate DateTime?
  // Set by the periodic-review sweep when an effective doc passes its review due
  // date; cleared on re-review / re-issue. Hook for proactive notifications.
  reviewOverdueAt DateTime?

  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  versions     DocumentVersion[]
  readReceipts DocumentReadReceipt[]

  @@index([type])
  @@index([status])
}

model DocumentVersion {
  id         String  @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  version      Int
  versionLabel String // e.g. "1.0", "2.0"
  contentType  DocContentType @default(EDITOR)
  content      String? // HTML authored in the online editor (EDITOR mode)
  // FILE mode — uploaded document stored inline as a base64 data URL.
  fileName     String?
  fileMime     String?
  fileSize     Int?
  fileData     String? // data URL ("data:<mime>;base64,…")
  changeSummary String?
  authorId     String?
  isLocked     Boolean  @default(false) // locked once issued (read-only)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([documentId, version])
  @@index([documentId])
}

// Controlled distribution — "read & understood" acknowledgements. When an
// effective document is assigned to readers, a PENDING receipt is created per
// (document, version, user); the reader acknowledges to satisfy it.
enum ReadReceiptStatus {
  PENDING
  ACKNOWLEDGED
}

model DocumentReadReceipt {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionId  String // version the reader was assigned to read
  userId     String // assignee (plain id, no FK)

  status         ReadReceiptStatus @default(PENDING)
  assignedById   String?
  assignedAt     DateTime          @default(now())
  acknowledgedAt DateTime?

  @@unique([documentId, versionId, userId])
  @@index([userId, status])
  @@index([documentId])
}

// ─────────────────────────── Training & Competency ───────────────────────────
// Training items (often a controlled Document / SOP), assigned to users. When a
// user acknowledges the linked document (read & understood), the matching
// training assignment auto-completes. Role/Document refs are plain ids (no FK).
enum TrainingStatus {
  ASSIGNED
  COMPLETED
}

model TrainingItem {
  id          String  @id @default(uuid())
  code        String  @unique
  title       String
  description String?
  documentId  String? // optional link to a controlled Document
  roleId      String? // optional "required for this role"
  isActive    Boolean @default(true)

  isDeleted   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments TrainingAssignment[]

  @@index([isActive])
}

model TrainingAssignment {
  id             String         @id @default(uuid())
  trainingItemId String
  trainingItem   TrainingItem   @relation(fields: [trainingItemId], references: [id], onDelete: Cascade)
  userId         String
  dueDate        DateTime?
  status         TrainingStatus @default(ASSIGNED)
  assignedById   String?
  assignedAt     DateTime       @default(now())
  completedAt    DateTime?

  @@unique([trainingItemId, userId])
  @@index([userId, status])
}

// ─────────────────────────── LIMS — Lab Registry ───────────────────────────
// Internal, partner and contract laboratories. First LIMS master-data entity;
// equipment, specifications and methods will reference labs. User refs are plain
// id columns (no FK) to keep the migration self-contained.
enum LabType {
  INTERNAL
  PARTNER
  CONTRACT
}

model Lab {
  id            String  @id @default(uuid())
  code          String  @unique
  name          String
  type          LabType @default(INTERNAL)
  gmpClass      String? // GMP classification (e.g. "GMP", "Non-GMP")
  siteCode      String?
  location      String?
  accreditation String? // e.g. "NABL, ISO 17025, USFDA"
  contactName   String?
  contactEmail  String?
  isActive      Boolean @default(true)

  isDeleted   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  equipment      Equipment[]
  certifications Certification[]
  samples        Sample[]

  @@index([type])
  @@index([isActive])
}

// ─────────────────────────── LIMS — Equipment & Calibration ───────────────────────────
enum EquipmentStatus {
  ACTIVE
  OUT_OF_SERVICE
  RETIRED
}

enum CalibrationResult {
  PASS
  FAIL
  CONDITIONAL
}

model Equipment {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  category     String? // instrument category (e.g. HPLC, Balance)
  labId        String? // link to Lab
  lab          Lab?            @relation(fields: [labId], references: [id], onDelete: SetNull)
  serialNo     String?
  manufacturer String?
  model        String?
  location     String?
  status       EquipmentStatus @default(ACTIVE)

  calibrationFrequencyDays Int?
  lastCalibratedAt         DateTime?
  calibrationDueAt         DateTime?

  isDeleted   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  calibrations CalibrationRecord[]
  sampleTests  SampleTest[]
  results      Result[]
  qcResults    QcResult[]

  @@index([status])
  @@index([labId])
}

model CalibrationRecord {
  id            String            @id @default(uuid())
  equipmentId   String
  equipment     Equipment         @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  calibratedAt  DateTime
  result        CalibrationResult @default(PASS)
  certificateNo String?
  nextDueAt     DateTime?
  performedBy   String?
  remarks       String?
  createdById   String?
  createdAt     DateTime          @default(now())

  @@index([equipmentId])
}

// ─────────────────────────── LIMS — Certifications ───────────────────────────
model Certification {
  id        String  @id @default(uuid())
  code      String  @unique
  type      String // GMP | NABL | ISO 17025 | USFDA | OTHER (free text)
  number    String?
  labId     String? // optional link to a Lab
  lab       Lab?    @relation(fields: [labId], references: [id], onDelete: SetNull)
  issuedBy  String?
  issueDate DateTime?
  expiryDate DateTime
  isActive  Boolean @default(true)
  // Set by the expiry sweep when within 30 days / expired; cleared on renewal.
  expiryFlaggedAt DateTime?

  isDeleted   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([labId])
  @@index([expiryDate])
}

// ─────────────────────────── LIMS — Test Methods ───────────────────────────
model TestMethod {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  technique   String? // e.g. HPLC, GC, Titration
  sopRef      String? // SOP / document reference
  documentId  String? // optional link to a DMS Document
  description String?
  defaultUnit String?
  price       Float? // for test-request pricing
  isActive    Boolean @default(true)

  isDeleted   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parameters      SpecParameter[]
  testDefinitions TestDefinition[]
  qcMaterials     QcMaterial[]
}

// ─────────────────────────── LIMS — Specification Library ───────────────────────────
enum SpecStatus {
  DRAFT
  APPROVED
  RETIRED
}

model Specification {
  id            String     @id @default(uuid())
  code          String     @unique
  productName   String
  version       Int        @default(1)
  status        SpecStatus @default(DRAFT)
  pharmacopoeia String? // e.g. IP, BP, USP
  description   String?
  isoStandardId String?
  effectiveDate DateTime?

  isDeleted   Boolean   @default(false)
  createdById String?
  approvedById String?
  approvedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parameters   SpecParameter[]
  samples      Sample[]
  specVersions SpecVersion[]

  @@index([status])
}

model SpecParameter {
  id              String  @id @default(uuid())
  specificationId String
  specification   Specification @relation(fields: [specificationId], references: [id], onDelete: Cascade)
  name            String
  unit            String?
  minValue        Float?
  maxValue        Float?
  targetValue     Float?
  textCriteria    String? // for qualitative limits (e.g. "Complies", "White powder")
  methodId        String?
  method          TestMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  pharmacopoeiaRef String?
  position        Int     @default(0)

  @@index([specificationId])
}

// ─────────────────────────── LIMS — Sample Lifecycle (W3) ───────────────────────────
enum SampleStatus {
  REGISTERED
  IN_TESTING
  IN_REVIEW
  RELEASED
  REJECTED
  CANCELLED
}

enum CustodyAction {
  REGISTERED
  RECEIVED
  TRANSFERRED
  STORED
  ALIQUOTED
  RETURNED
  DISPOSED
}

model StorageLocation {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  type     String? // Freezer | Fridge | Ambient | Cabinet
  tempZone String? // e.g. "2-8°C", "-20°C", "RT"
  location String?
  isActive Boolean @default(true)

  isDeleted   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  samples             Sample[]
  aliquots            Aliquot[]
  custodyFrom         CustodyEvent[]       @relation("CustodyFrom")
  custodyTo           CustodyEvent[]       @relation("CustodyTo")
  stabilityConditions StabilityCondition[]
}

model Sample {
  id              String       @id @default(uuid())
  sampleNumber    String       @unique
  barcode         String       @unique
  productName     String
  batchNo         String?
  sampleType      String? // Raw Material | Finished Product | In-Process | Stability
  sourceSite      String?
  specificationId String?
  quantity        Float?
  unit            String?
  collectedAt     DateTime?
  receivedAt      DateTime?
  status          SampleStatus @default(REGISTERED)
  labId           String?
  currentLocationId String?
  priority        String? // Low | Normal | High | Urgent
  remarks         String?

  isDeleted   Boolean   @default(false)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // LIMS 2.0 — login binds product + effective spec; disposition is e-signed
  productId      String?
  specVersionId  String?
  reviewedById   String?
  reviewedAt     DateTime?
  disposition    String? // RELEASED | REJECTED
  releasedById   String?
  releasedAt     DateTime?

  // ── relations (FKs to master data + 2.0 binds) ──
  specification   Specification?   @relation(fields: [specificationId], references: [id], onDelete: SetNull)
  lab             Lab?             @relation(fields: [labId], references: [id], onDelete: SetNull)
  currentLocation StorageLocation? @relation(fields: [currentLocationId], references: [id], onDelete: SetNull)
  product         Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  specVersion     SpecVersion?     @relation(fields: [specVersionId], references: [id], onDelete: SetNull)

  custodyEvents     CustodyEvent[]
  aliquots          Aliquot[]
  sampleTests       SampleTest[]
  oosInvestigations OosInvestigation[]
  stabilityPulls    StabilityPull[]
  coas              Coa[]

  @@index([status])
}

model CustodyEvent {
  id             String        @id @default(uuid())
  sampleId       String
  sample         Sample        @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  action         CustodyAction
  fromLocationId String?
  fromLocation   StorageLocation? @relation("CustodyFrom", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId   String?
  toLocation     StorageLocation? @relation("CustodyTo", fields: [toLocationId], references: [id], onDelete: SetNull)
  handlerName    String?
  handledById    String?
  occurredAt     DateTime      @default(now())
  remarks        String?
  createdAt      DateTime      @default(now())

  @@index([sampleId])
}

model Aliquot {
  id                String    @id @default(uuid())
  sampleId          String
  sample            Sample    @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  code              String
  storageLocationId String?
  storageLocation   StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  tempZone          String?
  quantity          Float?
  unit              String?
  expiryAt          DateTime?
  status            String    @default("STORED")
  createdById       String?
  createdAt         DateTime  @default(now())

  @@unique([sampleId, code])
  @@index([sampleId])
}

// ─────────────────────────── LIMS 2.0 — L0 Master Data ───────────────────────────
model Product {
  id String @id @default(uuid())
  code String @unique
  name String
  grade String?
  dosageForm String?
  strength String?
  category String?
  markets String? // comma-separated market list
  defaultPanelId String? // LIMS 2.0 — auto-attached test panel at sample login
  defaultPanel TestPanel? @relation(fields: [defaultPanelId], references: [id], onDelete: SetNull)
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  samples          Sample[]
  specVersions     SpecVersion[]
  stabilityStudies StabilityStudy[]
}

model Analyte {
  id String @id @default(uuid())
  code String @unique
  name String
  defaultUnit String?
  dataType String @default("NUMERIC") // NUMERIC | TEXT | BOOLEAN
  category String?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  testAnalytes TestAnalyte[]
  specLines    SpecLine[]
}

model UnitOfMeasure {
  id String @id @default(uuid())
  code String @unique
  name String
  symbol String?
  kind String? // mass | volume | concentration | count | ratio
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SamplingPoint {
  id String @id @default(uuid())
  code String @unique
  name String
  area String?
  description String?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id String @id @default(uuid())
  code String @unique
  name String
  contactName String?
  email String?
  country String?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coas         Coa[]
  coaTemplates CoaTemplate[]
}

model Supplier {
  id String @id @default(uuid())
  code String @unique
  name String
  contactName String?
  email String?
  country String?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────── LIMS 2.0 — L1 Test Definitions & Spec Versions ───────────────────────────
model TestDefinition {
  id String @id @default(uuid())
  code String @unique
  name String
  technique String?
  methodId String?   // link to TestMethod
  method TestMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  version Int @default(1)
  status String @default("DRAFT") // DRAFT | APPROVED | RETIRED
  description String?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  analytes    TestAnalyte[]
  panelItems  TestPanelItem[]
  specLines   SpecLine[]
  sampleTests SampleTest[]
}

model TestAnalyte {
  id String @id @default(uuid())
  testDefinitionId String
  testDefinition TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Cascade)
  analyteId String?   // link to Analyte master
  analyte Analyte? @relation(fields: [analyteId], references: [id], onDelete: SetNull)
  name String         // denormalised label
  unit String?
  dataType String @default("NUMERIC") // NUMERIC | TEXT | BOOLEAN | TITRATION
  decimals Int?
  calculation String? // formula expression, e.g. (area/std_area)*std_conc
  sequence Int @default(0)
  createdAt DateTime @default(now())
  @@index([testDefinitionId])
}

model TestPanel {
  id String @id @default(uuid())
  code String @unique
  name String
  description String?
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items TestPanelItem[]
  defaultForProducts Product[]
}

model TestPanelItem {
  id String @id @default(uuid())
  panelId String
  panel TestPanel @relation(fields: [panelId], references: [id], onDelete: Cascade)
  testDefinitionId String
  testDefinition TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Cascade)
  sequence Int @default(0)
  @@index([panelId])
}

model SpecVersion {
  id String @id @default(uuid())
  code String @unique
  specificationId String?  // link to existing Specification (optional)
  specification Specification? @relation(fields: [specificationId], references: [id], onDelete: SetNull)
  productId String?        // link to Product master
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name String
  stage String @default("RELEASE") // RELEASE | STABILITY | IN_PROCESS | RAW_MATERIAL
  grade String?
  market String?
  version Int @default(1)
  status String @default("DRAFT") // DRAFT | APPROVED | SUPERSEDED | RETIRED
  pharmacopoeia String?
  effectiveDate DateTime?
  approvedAt DateTime?
  approvedById String?
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines            SpecLine[]
  samples          Sample[]
  sampleTests      SampleTest[]
  stabilityStudies StabilityStudy[]
  coas             Coa[]
}

model SpecLine {
  id String @id @default(uuid())
  specVersionId String
  specVersion SpecVersion @relation(fields: [specVersionId], references: [id], onDelete: Cascade)
  analyteId String?
  analyte Analyte? @relation(fields: [analyteId], references: [id], onDelete: SetNull)
  testDefinitionId String?
  testDefinition TestDefinition? @relation(fields: [testDefinitionId], references: [id], onDelete: SetNull)
  name String
  unit String?
  minValue Float?
  maxValue Float?
  targetValue Float?
  textCriteria String?
  decimals Int?
  sigFigs Int?
  mandatory Boolean @default(true)
  sequence Int @default(0)
  createdAt DateTime @default(now())
  results Result[]
  @@index([specVersionId])
}

// ─────────────────────────── LIMS 2.0 — M-LIMS-B Core Testing (L2–L5) ───────────────────────────
// A test assigned to a sample (sample × test definition), bound to the spec
// version effective at login. Carries analyst, instrument, worklist, review.
model SampleTest {
  id String @id @default(uuid())
  sampleId String
  sample Sample @relation(fields: [sampleId], references: [id], onDelete: Cascade)
  testDefinitionId String
  testDefinition TestDefinition @relation(fields: [testDefinitionId], references: [id], onDelete: Restrict)
  testName String          // denormalised test definition name
  specVersionId String?    // effective spec bound at assignment
  specVersion SpecVersion? @relation(fields: [specVersionId], references: [id], onDelete: SetNull)
  worklistId String?
  worklist Worklist? @relation(fields: [worklistId], references: [id], onDelete: SetNull)
  status String @default("PENDING") // PENDING | IN_PROGRESS | COMPLETED | REVIEWED | CANCELLED
  overallResult String?    // PASS | FAIL | OOS
  analystId String?
  analystName String?
  instrumentId String?      // link to Equipment
  instrument Equipment? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  startedAt DateTime?
  completedAt DateTime?
  reviewStatus String @default("PENDING") // PENDING | APPROVED | REJECTED
  reviewedById String?
  reviewedAt DateTime?
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results Result[]
  oosInvestigations OosInvestigation[]
  @@index([sampleId])
  @@index([worklistId])
  @@index([status])
}

// One measured value per analyte within a SampleTest, auto-evaluated vs the
// bound spec line into PASS / OOS / OOT.
model Result {
  id String @id @default(uuid())
  sampleTestId String
  sampleTest SampleTest @relation(fields: [sampleTestId], references: [id], onDelete: Cascade)
  analyteName String
  specLineId String?
  specLine SpecLine? @relation(fields: [specLineId], references: [id], onDelete: SetNull)
  unit String?
  numericValue Float?
  textValue String?
  evaluation String @default("PENDING") // PENDING | PASS | OOS | OOT | NA
  isOutOfSpec Boolean @default(false)
  minValue Float?         // snapshot of the limit evaluated against
  maxValue Float?
  decimals Int?
  calculation String?
  instrumentId String?
  instrument Equipment? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  enteredById String?
  enteredAt DateTime @default(now())
  createdAt DateTime @default(now())
  oosInvestigations OosInvestigation[]
  @@index([sampleTestId])
}

// A batch/run grouping SampleTests for an analyst or instrument, with system
// suitability capture.
model Worklist {
  id String @id @default(uuid())
  code String @unique
  name String
  status String @default("OPEN") // OPEN | IN_PROGRESS | CLOSED
  analystId String?
  analystName String?
  instrumentId String?
  systemSuitability String? // free text / JSON
  notes String?
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tests SampleTest[]
}

// Formal OOS/OOT investigation (Phase 1A lab → 1B → Phase 2) raised from an
// out-of-spec result, optionally linked to a CAPA.
model OosInvestigation {
  id String @id @default(uuid())
  code String @unique
  sampleId String?
  sample Sample? @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  sampleTestId String?
  sampleTest SampleTest? @relation(fields: [sampleTestId], references: [id], onDelete: SetNull)
  resultId String?
  result Result? @relation(fields: [resultId], references: [id], onDelete: SetNull)
  title String
  phase String @default("PHASE_1A") // PHASE_1A | PHASE_1B | PHASE_2 | CLOSED
  status String @default("OPEN")     // OPEN | IN_PROGRESS | CLOSED
  classification String?             // LAB_ERROR | NON_LAB_ERROR | CONFIRMED_OOS | INVALIDATED
  hypothesis String?
  investigationSummary String?
  retestRequired Boolean @default(false)
  resampleRequired Boolean @default(false)
  conclusion String?
  capaId String?                     // link to standalone CAPA record
  capaTicketId String?               // CAPA workflow ticket raised from this OOS
  capaTicketUniqueId String?         // human ticket id (e.g. CAPA-0001) for display/links
  openedById String?
  openedAt DateTime @default(now())
  closedById String?
  closedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sampleId])
  @@index([status])
}

// ─────────────────────────── LIMS 2.0 — M-LIMS-C  L6 QC (Levey-Jennings / Westgard) ───────────────────────────
model QcMaterial {
  id String @id @default(uuid())
  code String @unique
  name String
  analyteName String?
  methodId String?
  method TestMethod? @relation(fields: [methodId], references: [id], onDelete: SetNull)
  lotNo String?
  unit String?
  targetMean Float?   // established mean for the control
  targetSd Float?     // established standard deviation
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  results QcResult[]
}

model QcResult {
  id String @id @default(uuid())
  qcMaterialId String
  qcMaterial QcMaterial @relation(fields: [qcMaterialId], references: [id], onDelete: Cascade)
  value Float
  measuredAt DateTime @default(now())
  analystName String?
  instrumentId String?
  instrument Equipment? @relation(fields: [instrumentId], references: [id], onDelete: SetNull)
  zScore Float?
  status String @default("ACCEPT") // ACCEPT | WARN | REJECT
  violatedRules String?            // comma-separated Westgard rules, e.g. "1-2s,2-2s"
  remarks String?
  createdById String?
  createdAt DateTime @default(now())
  @@index([qcMaterialId])
}

// ─────────────────────────── LIMS 2.0 — M-LIMS-C  L7 Stability (ICH Q1A) ───────────────────────────
model StabilityStudy {
  id String @id @default(uuid())
  code String @unique
  productId String?
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  batchNo String?
  title String
  specVersionId String?
  specVersion SpecVersion? @relation(fields: [specVersionId], references: [id], onDelete: SetNull)
  packaging String?
  status String @default("DRAFT") // DRAFT | ACTIVE | COMPLETED | CANCELLED
  startDate DateTime?
  timepointsMonths String @default("0,3,6,9,12,18,24")
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  conditions StabilityCondition[]
  pulls StabilityPull[]
}

model StabilityCondition {
  id String @id @default(uuid())
  studyId String
  study StabilityStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  name String           // e.g. Long-term 25°C/60%RH
  tempZone String?
  storageLocationId String?
  storageLocation StorageLocation? @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  orientation String?
  createdAt DateTime @default(now())
  pulls StabilityPull[]
  @@index([studyId])
}

model StabilityPull {
  id String @id @default(uuid())
  studyId String
  study StabilityStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)
  conditionId String?
  condition StabilityCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  conditionName String?
  timepointLabel String  // e.g. 3M
  timepointMonths Int
  scheduledDate DateTime
  status String @default("SCHEDULED") // SCHEDULED | DUE | PULLED | TESTED | SKIPPED
  sampleId String?       // sample generated when pulled
  sample Sample? @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  pulledAt DateTime?
  testedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([studyId])
  @@index([status])
}

// ─────────────────────────── LIMS 2.0 — M-LIMS-D  L8 Certificate of Analysis ───────────────────────────
model CoaTemplate {
  id String @id @default(uuid())
  code String @unique
  name String
  title String?           // printed document title
  headerHtml String?
  footerHtml String?
  sections String @default("description,results,conclusion,signatures") // ordered, comma-separated
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  isActive Boolean @default(true)
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  coas Coa[]
}

model Coa {
  id String @id @default(uuid())
  coaNumber String @unique
  sampleId String?
  sample Sample? @relation(fields: [sampleId], references: [id], onDelete: SetNull)
  productName String
  batchNo String?
  specVersionId String?
  specVersion SpecVersion? @relation(fields: [specVersionId], references: [id], onDelete: SetNull)
  templateId String?
  template CoaTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  customerId String?
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status String @default("DRAFT") // DRAFT | ISSUED | REVOKED
  verifyToken String? @unique     // QR public-verification token (set at issue)
  conclusion String?
  resultsJson String?             // snapshot of tests/results at issue time
  issuedById String?
  issuedAt DateTime?
  revokedById String?
  revokedAt DateTime?
  isDeleted Boolean @default(false)
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([sampleId])
  @@index([status])
}
